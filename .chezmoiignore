{{- $isWindows := eq .chezmoi.os "windows" -}}
{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $user := lower (last (splitList "\\" .chezmoi.username)) -}}
{{- $isWorkWin := and $isWindows (eq $user "willier") -}}
{{- $useWorkPwsh := $isWorkWin -}}
{{- $useLocalPwsh := and $isWindows (not $isWorkWin) -}}
{{- $profile := get . "profile" | default "home" -}}

# Bootstrap / root-only files
bootstrap.sh
bootstrap.ps1
uninstall.ps1
uninstall.sh
README.md
CLAUDE.md
install-core.ps1
install-core.sh
setup-github-ssh.ps1
setup-github-ssh.sh
docs/

# Runtime-only state
# Claude Code accumulates local permissions here; never manage it.
.claude/settings.local.json

# OS target gating
# macOS-only targets
{{ if not $isDarwin }}
Library/
{{ end }}

# Windows-only targets
{{ if not $isWindows }}
AppData/
Documents/
OneDrive - Powerfleet/
.scripts/*.ps1
.local/bin/*.ps1
{{ end }}

# POSIX-only targets
{{ if $isWindows }}
.scripts/*.sh
.local/bin/*.sh
{{ end }}

# Zsh-only targets (no zsh on Windows; these are dead weight there)
{{ if $isWindows }}
.zshrc
.zshenv
.p10k.zsh
.config/shell/aliases.zsh
.config/shell/fzf.zsh
.config/shell/helpers.zsh
{{ end }}

# Excluded ON Linux (not "Linux-only" -- misleading label, corrected 2026-09-02
# TODO-4 audit): Linux machines in this fleet are remote SSH targets accessed
# from a Windows/macOS VS Code client (see ms-vscode-remote.remote-ssh in the
# extensions list), not local desktops running VS Code themselves -- so no
# local .vscode/ or extensions installer is needed there.
{{ if $isLinux }}
.vscode/
install-vscode-extensions.sh
install-vscode-extensions.ps1
{{ end }}

# VS Code installer selection
{{ if $isWindows }}
install-vscode-extensions.sh
{{ end }}

{{ if and (not $isWindows) (not $isLinux) }}
install-vscode-extensions.ps1
{{ end }}

# PowerShell profile location
{{ if $useWorkPwsh }}
Documents/
{{ end }}

{{ if $useLocalPwsh }}
OneDrive - Powerfleet/
{{ end }}

