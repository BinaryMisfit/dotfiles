{{- $isWindows := eq .chezmoi.os "windows" -}}
{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $user := lower (last (splitList "\\" .chezmoi.username)) -}}
{{- $isWorkWin := and $isWindows (eq $user "willier") -}}
{{- $useWorkPwsh := $isWorkWin -}}
{{- $useLocalPwsh := and $isWindows (not $isWorkWin) -}}
{{- $profile := get . "profile" | default "home" -}}

# Bootstrap / root-only files
bootstrap.sh
bootstrap.ps1
README.md
CLAUDE.md
install-core.ps1
install-core.sh
setup-github-ssh.ps1
setup-github-ssh.sh
docs/

# Runtime-only state
# Claude Code accumulates local permissions here; never manage it.
.claude/settings.local.json

# OS target gating
# macOS-only targets
{{ if not $isDarwin }}
Library/
{{ end }}

# Windows-only targets
{{ if not $isWindows }}
AppData/
Documents/
OneDrive - Powerfleet/
.scripts/*.ps1
.local/bin/*.ps1
{{ end }}

# POSIX-only targets
{{ if $isWindows }}
.config/shell/env.zsh
.scripts/*.sh
.local/bin/*.sh
{{ end }}

# Linux-only targets
{{ if $isLinux }}
.vscode/
install-vscode-extensions.sh
install-vscode-extensions.ps1
{{ end }}

# VS Code installer selection
{{ if $isWindows }}
install-vscode-extensions.sh
{{ end }}

{{ if and (not $isWindows) (not $isLinux) }}
install-vscode-extensions.ps1
{{ end }}

# PowerShell profile location
{{ if $useWorkPwsh }}
Documents/
{{ end }}

{{ if $useLocalPwsh }}
OneDrive - Powerfleet/
{{ end }}

# AI tool profile gating
# Claude Code: home profile only (default)
{{ if ne $profile "home" }}
.claude/**
{{ end }}

# Copilot: work profile only
{{ if ne $profile "work" }}
.copilot/**
{{ end }}

# Codex: removed entirely
dot_codex/
.codex/
