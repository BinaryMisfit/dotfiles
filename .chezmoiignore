{{- $isWindows := eq .chezmoi.os "windows" -}}
{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $user := lower (last (splitList "\\" .chezmoi.username)) -}}
{{- $isWorkWin := and $isWindows (eq $user "willier") -}}
{{- $useWorkPwsh := $isWorkWin -}}
{{- $useLocalPwsh := and $isWindows (not $isWorkWin) -}}
{{- $scoopVscodeData := joinPath .chezmoi.homeDir "scoop" "persist" "vscode" "data" -}}
{{- $scoopVscodeExe := joinPath .chezmoi.homeDir "scoop" "apps" "vscode" "current" "Code.exe" -}}
{{- $isScoopVscode := and (eq .chezmoi.os "windows") (stat $scoopVscodeData) (stat $scoopVscodeExe) -}}
{{- $vscodeMode := "system" -}}
{{- if $isScoopVscode -}}
{{- $vscodeMode = "scoop" -}}
{{- end -}}
{{- $profile := get . "profile" | default "home" -}}

# Bootstrap / root-only files
bootstrap.sh
bootstrap.ps1
README.md
CLAUDE.md
install-core.ps1
install-core.sh
setup-github-ssh.ps1
setup-github-ssh.sh

# Runtime-only state
# MCP runtime state must never be managed by chezmoi.
.local/share/mcp/**
AppData/Local/MCP/**
# Claude Code accumulates local permissions here; never manage it.
.claude/settings.local.json

# OS target gating
# macOS-only targets
{{ if not $isDarwin }}
Library/
{{ end }}

# Windows-only targets
{{ if not $isWindows }}
AppData/
scoop/
Documents/
OneDrive - Powerfleet/
.scripts/*.ps1
.local/bin/*.ps1
{{ end }}

# POSIX-only targets
{{ if $isWindows }}
.config/shell/env.zsh
.scripts/*.sh
.local/bin/*.sh
{{ end }}

# Linux-only targets
{{ if $isLinux }}
.vscode/
install-vscode-extensions.sh
install-vscode-extensions.ps1
{{ end }}

# VS Code target selection
# Prefer Scoop portable VS Code data over AppData/Roaming/Code on Windows.
{{ if and $isWindows (eq $vscodeMode "scoop") }}
AppData/Roaming/Code/
{{ end }}

{{ if and $isWindows (eq $vscodeMode "system") }}
scoop/
{{ end }}

# VS Code installer selection
{{ if $isWindows }}
install-vscode-extensions.sh
{{ end }}

{{ if and (not $isWindows) (not $isLinux) }}
install-vscode-extensions.ps1
{{ end }}

# PowerShell profile location
{{ if $useWorkPwsh }}
Documents/
{{ end }}

{{ if $useLocalPwsh }}
OneDrive - Powerfleet/
{{ end }}

# Copilot profile gating
# work: all instructions and skills deployed
# home (default): only k1ra personality and settings deployed
{{ if ne $profile "work" }}
.copilot/instructions/external-services.instructions.md
.copilot/instructions/pull-requests.instructions.md
.copilot/instructions/branches.instructions.md
.copilot/instructions/jira.instructions.md
.copilot/instructions/commits.instructions.md
.copilot/skills/feature-workflow/
.copilot/skills/defect-workflow/
.copilot/skills/jira-transition-status/
.copilot/skills/jira-post-fix-update-comment/
.copilot/skills/jira-post-qa-test-plan/
{{ end }}

# Codex profile gating
# home (default): AGENTS.md and skills deployed
# work: codex not relevant
{{ if eq $profile "work" }}
.codex/**
{{ end }}

# Claude profile gating
# work: all rules and skills deployed
# home (default): only k1ra and continuation-context-pack deployed
{{ if ne $profile "work" }}
.claude/rules/branches.instructions.md
.claude/rules/commits.instructions.md
.claude/rules/external-services.instructions.md
.claude/rules/jira.instructions.md
.claude/rules/pull-requests.instructions.md
.claude/skills/branch-start-work/
.claude/skills/commit-ready-check/
