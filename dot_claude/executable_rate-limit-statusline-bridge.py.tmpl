{{- $profile := get . "profile" | default "" -}}
#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import socket
import sys
import urllib.error
import urllib.request

ENDPOINT = os.environ.get("AI_USAGE_PROVIDER_LIMITS_ENDPOINT", "https://ai-usage.fairview.zone/provider-limits")
TIMEOUT_SECONDS = 1.5


def _number(value):
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, (int, float)):
        return value
    if isinstance(value, str):
        try:
            return float(value) if "." in value else int(value)
        except ValueError:
            return None
    return None


def _limit(raw):
    if not isinstance(raw, dict):
        return None
    used_percentage = _number(raw.get("used_percentage"))
    resets_at = _number(raw.get("resets_at"))
    if used_percentage is None or resets_at is None:
        return None
    return {"used_percentage": used_percentage, "resets_at": int(resets_at)}


def _sanitized_payload(raw):
    if not isinstance(raw, dict):
        return None
    rate_limits = raw.get("rate_limits")
    if not isinstance(rate_limits, dict):
        return None
    limits = {}
    for window in ("five_hour", "seven_day"):
        value = _limit(rate_limits.get(window))
        if value is not None:
            limits[window] = value
    if not limits:
        return None
    return {"tool": "claude", "source": "claude-statusline", "limits": limits}


def _post(payload):
    data = json.dumps(payload, separators=(",", ":")).encode("utf-8")
    request = urllib.request.Request(
        ENDPOINT,
        data=data,
        method="POST",
        headers={"content-type": "application/json"},
    )
    try:
        urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS).close()
    except (OSError, urllib.error.URLError, urllib.error.HTTPError, TimeoutError):
        pass


def _model_safe(text):
    """Return True if text is safe to display: alphanumeric, dash, dot only."""
    if not text or len(text) > 100:
        return False
    if not text[0].isalnum():
        return False
    return all(c.isalnum() or c in "-." for c in text)


def _compact_model(raw):
    """Extract a compact model name for display only. Never forwarded."""
    if not isinstance(raw, dict):
        return None
    model = raw.get("model")
    if not isinstance(model, str) or not _model_safe(model):
        return None
    name = model[len("claude-"):] if model.startswith("claude-") else model
    parts = name.split("-")
    for i, part in enumerate(parts):
        if part.isdigit():
            label = "-".join(parts[:i])
            major = part
            rest = parts[i + 1 :]
            if rest and rest[0].isdigit() and len(rest[0]) <= 2:
                return f"{label}-{major}.{rest[0]}" if label else f"{major}.{rest[0]}"
            return f"{label}-{major}" if label else major
    return name


def _quota_parts(raw):
    """Return display strings for quota availability, e.g. ['5h 87%', '7d 94%']."""
    if not isinstance(raw, dict):
        return []
    rate_limits = raw.get("rate_limits")
    if not isinstance(rate_limits, dict):
        return []
    parts = []
    for window, label in (("five_hour", "5h"), ("seven_day", "7d")):
        limit = rate_limits.get(window)
        if not isinstance(limit, dict):
            continue
        used = _number(limit.get("used_percentage"))
        if used is None:
            continue
        available = max(0.0, min(100.0, 100.0 - used))
        parts.append(f"{label} {available:.0f}%")
    return parts


def _status_text(raw):
    user = os.environ.get("USER") or os.environ.get("USERNAME") or "user"
    host = socket.gethostname().split(".", 1)[0] or "host"
    directory = os.path.basename(os.getcwd()) or os.getcwd()
    base = f"{user}@{host} {directory}"
    suffix = []
    model = _compact_model(raw)
    if model:
        suffix.append(model)
    suffix.extend(_quota_parts(raw))
    return f"{base} | {' | '.join(suffix)}" if suffix else base


def main() -> int:
    try:
        raw = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        raw = {}
    payload = _sanitized_payload(raw)
    {{- if eq $profile "home" }}
    if payload is not None:
        _post(payload)
    {{- end }}
    print(_status_text(raw), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
