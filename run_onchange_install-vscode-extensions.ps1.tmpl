#!powershell
{{ $scoopVscodeData := joinPath .chezmoi.homeDir "scoop" "persist" "vscode" "data" -}}
{{- $scoopVscodeExe := joinPath .chezmoi.homeDir "scoop" "apps" "vscode" "current" "Code.exe" -}}
{{- $isScoopVscode := and (eq .chezmoi.os "windows") (stat $scoopVscodeData) (stat $scoopVscodeExe) -}}
{{- $vscodeMode := "system" -}}
{{- if $isScoopVscode -}}
{{- $vscodeMode = "scoop" -}}
{{- end -}}
$ErrorActionPreference = "Stop"

# extensions checksum: {{ include ".chezmoitemplates/vscode/extensions.txt.tmpl" | sha256sum }}-{{ get (get . "vscode" | default dict) "profile" | default "home" }}

$vscodeMode = "{{ $vscodeMode }}"
$extFile = Join-Path $HOME ".vscode\extensions.txt"

if (-not (Test-Path $extFile)) {
    exit 0
}

$code = Get-Command code -ErrorAction SilentlyContinue

if (-not $code) {
    Write-Host "code CLI not found, skipping extensions"
    exit 0
}

$scoopPortableData = "{{ $scoopVscodeData }}"
$scoopExtensionsDir = Join-Path $scoopPortableData "extensions"

$codeArgs = @()
Write-Host "VS Code mode: $vscodeMode"

if ($vscodeMode -eq "scoop") {
    New-Item -ItemType Directory -Force -Path $scoopExtensionsDir | Out-Null
    $codeArgs += @("--extensions-dir", $scoopExtensionsDir)
    Write-Host "Detected Scoop/portable VS Code extensions dir: $scoopExtensionsDir"
} else {
    Write-Host "Detected normal VS Code extension layout"
}

$stateFile = Join-Path $HOME ".vscode\extensions.managed.txt"

if (-not (Test-Path $stateFile)) {
    $installed = code @codeArgs --list-extensions 2>$null
    if ($installed) {
        $installed | Out-File -FilePath $stateFile -Encoding UTF8
    }
}

if (Test-Path $stateFile) {
    $desired = Get-Content $extFile | Where-Object { $_ -and -not $_.StartsWith("#") } | ForEach-Object { $_.Trim() }
    Get-Content $stateFile | Where-Object { $_ } | ForEach-Object {
        $ext = $_.Trim()
        if ($ext -and $ext -notin $desired) {
            Write-Host "Uninstalling VS Code extension: $ext"
            code @codeArgs --uninstall-extension $ext | Out-Null
        }
    }
}

Get-Content $extFile | ForEach-Object {
    $ext = $_.Trim()

    if (-not $ext -or $ext.StartsWith("#")) {
        return
    }

    Write-Host "Installing VS Code extension: $ext"
    code @codeArgs --install-extension $ext --force | Out-Null
}

Get-Content $extFile | Where-Object { $_ -and -not $_.StartsWith("#") } | ForEach-Object { $_.Trim() } | Out-File -FilePath $stateFile -Encoding UTF8
