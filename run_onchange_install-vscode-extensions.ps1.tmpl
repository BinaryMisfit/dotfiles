#!powershell
$ErrorActionPreference = "Stop"

# extensions checksum: {{ include ".chezmoitemplates/vscode/extensions.txt.tmpl" | sha256sum }}-{{ get . "profile" | default "home" }}

$extFile = Join-Path $HOME ".vscode\extensions.txt"

if (-not (Test-Path $extFile)) {
    exit 0
}

$code = Get-Command code -ErrorAction SilentlyContinue

if (-not $code) {
    Write-Host "code CLI not found, skipping extensions"
    exit 0
}

$stateFile = Join-Path $HOME ".vscode\extensions.managed.txt"

if (-not (Test-Path $stateFile)) {
    $installed = code --list-extensions 2>$null
    if ($installed) {
        $installed | Out-File -FilePath $stateFile -Encoding UTF8
    }
}

if (Test-Path $stateFile) {
    $desired = Get-Content $extFile | Where-Object { $_ -and -not $_.StartsWith("#") } | ForEach-Object { $_.Trim() }
    Get-Content $stateFile | Where-Object { $_ } | ForEach-Object {
        $ext = $_.Trim()
        if ($ext -and $ext -notin $desired) {
            Write-Host "Uninstalling VS Code extension: $ext"
            code --uninstall-extension $ext | Out-Null
        }
    }
}

Get-Content $extFile | ForEach-Object {
    $ext = $_.Trim()

    if (-not $ext -or $ext.StartsWith("#")) {
        return
    }

    Write-Host "Installing VS Code extension: $ext"
    code --install-extension $ext --force | Out-Null
}

Get-Content $extFile | Where-Object { $_ -and -not $_.StartsWith("#") } | ForEach-Object { $_.Trim() } | Out-File -FilePath $stateFile -Encoding UTF8
