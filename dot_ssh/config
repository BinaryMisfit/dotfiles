# Global defaults
Host *
  AddKeysToAgent yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  SendEnv LANG LC_*

# Github
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_github
  IdentitiesOnly yes
  AddKeysToAgent yes

# Local overrides (NOT tracked)
Include ~/.ssh/config.local
Include ~/.ssh/conf.d/*