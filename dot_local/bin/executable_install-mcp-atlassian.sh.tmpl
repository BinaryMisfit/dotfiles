#!/usr/bin/env zsh
set -eu

VSCODE_MCP_CONFIG_PATH=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --vscode-mcp-config-path)
      VSCODE_MCP_CONFIG_PATH="${2:-}"
      shift 2
      ;;
    *)
      echo "install-mcp-atlassian: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

if [ "$(uname -s)" != "Darwin" ]; then
  echo "install-mcp-atlassian: macOS installer only. Windows uses install-mcp-atlassian.ps1; Linux is intentionally out of scope." >&2
  exit 1
fi

BASE_DIR="$HOME/.local/share/mcp"
SERVER_DIR="$BASE_DIR/atlassian"
LOG_DIR="$SERVER_DIR/logs"
REGISTRY_PATH="$BASE_DIR/registry.json"
PORT_PATH="$SERVER_DIR/port"
ENV_PATH="$SERVER_DIR/.env"
ENV_EXAMPLE_PATH="$HOME/.config/mcp/mcp-atlassian.env.example"
LABEL="dev.binarymisfit.mcp.atlassian"
PLIST_PATH="$HOME/Library/LaunchAgents/$LABEL.plist"

mkdir -p "$BASE_DIR" "$SERVER_DIR" "$LOG_DIR" "$HOME/Library/LaunchAgents"

UVX_PATH="$(command -v uvx || true)"
if [ -z "$UVX_PATH" ]; then
  echo "install-mcp-atlassian: uvx is missing. Install uv manually, then rerun; this installer does not auto-install dependencies." >&2
  exit 1
fi

if [ ! -f "$ENV_PATH" ]; then
  if [ ! -f "$ENV_EXAMPLE_PATH" ]; then
    echo "install-mcp-atlassian: env example not found at $ENV_EXAMPLE_PATH. Run chezmoi apply or create $ENV_PATH manually." >&2
    exit 1
  fi
  cp "$ENV_EXAMPLE_PATH" "$ENV_PATH"
  chmod 600 "$ENV_PATH" 2>/dev/null || true
fi

json_eval() {
  /usr/bin/osascript -l JavaScript "$@"
}

prune_backups() {
  local path="$1"
  local keep="${2:-5}"
  local dir="${path:h}"
  local leaf="${path:t}"
  local -a backups
  [ -d "$dir" ] || return 0
  backups=("${(@f)$(find "$dir" -maxdepth 1 -type f -name "$leaf.bak.*" -print 2>/dev/null | sort -r)}")
  local count="${#backups[@]}"
  [ "$count" -le "$keep" ] && return 0
  local idx
  for idx in $(seq $((keep + 1)) "$count"); do
    rm -f "$backups[$idx]" 2>/dev/null || echo "install-mcp-atlassian: warning: failed to prune backup '$backups[$idx]'." >&2
  done
}

backup_file_if_changing() {
  local path="$1"
  local new_text="$2"
  [ -f "$path" ] || return 1
  [ "$(cat "$path")" = "$new_text" ] && return 1
  cp "$path" "$path.bak.$(date +%Y%m%d%H%M%S)"
}

write_file_if_changed() {
  local path="$1"
  local new_text="$2"
  if [ -f "$path" ] && [ "$(cat "$path")" = "$new_text" ]; then
    return 1
  fi
  mkdir -p "${path:h}"
  local backed_up=0
  if backup_file_if_changing "$path" "$new_text"; then
    backed_up=1
  fi
  printf "%s" "$new_text" > "$path"
  if [ "$backed_up" -eq 1 ]; then
    prune_backups "$path"
  fi
}

read_existing_port() {
  json_eval <<EOF
ObjC.import('Foundation');
const path = '$REGISTRY_PATH';
const fm = $.NSFileManager.defaultManager;
if (!fm.fileExistsAtPath(path)) {
  '';
} else {
  const data = $.NSData.dataWithContentsOfFile(path);
  const text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
  if (!text.trim()) {
    '';
  } else {
    const obj = JSON.parse(text);
    obj.servers && obj.servers['mcp-atlassian'] && obj.servers['mcp-atlassian'].port ? String(obj.servers['mcp-atlassian'].port) : '';
  }
}
EOF
}

port_is_listening() {
  nc -z 127.0.0.1 "$1" >/dev/null 2>&1
}

agent_is_loaded() {
  launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1
}

select_port() {
  local existing
  existing="$(read_existing_port || true)"
  if [ -n "$existing" ]; then
    if ! port_is_listening "$existing"; then
      echo "$existing"
      return
    fi
    if agent_is_loaded; then
      echo "$existing"
      return
    fi
  fi

  if ! port_is_listening 9310; then
    echo "9310"
    return
  fi

  local port
  for port in $(seq 9311 9399); do
    if ! port_is_listening "$port"; then
      echo "$port"
      return
    fi
  done

  echo "install-mcp-atlassian: no available ports in deterministic range 9310-9399." >&2
  exit 1
}

write_registry() {
  local port="$1"
  local url="http://127.0.0.1:$port/mcp"
  local next
  next="$(env REGISTRY_PATH="$REGISTRY_PATH" PORT="$port" URL="$url" /usr/bin/osascript -l JavaScript <<'EOF'
ObjC.import('Foundation');
const path = $.NSProcessInfo.processInfo.environment.objectForKey('REGISTRY_PATH').js;
const port = Number($.NSProcessInfo.processInfo.environment.objectForKey('PORT').js);
const url = $.NSProcessInfo.processInfo.environment.objectForKey('URL').js;
const fm = $.NSFileManager.defaultManager;
let obj = { range: { start: 9310, end: 9399 }, servers: {} };
if (fm.fileExistsAtPath(path)) {
  const data = $.NSData.dataWithContentsOfFile(path);
  const text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
  if (text.trim()) obj = JSON.parse(text);
}
obj.range = { start: 9310, end: 9399 };
obj.servers = obj.servers || {};
obj.servers['mcp-atlassian'] = { port, url, transport: 'streamable-http' };
JSON.stringify(obj, null, 2);
EOF
)"
  write_file_if_changed "$REGISTRY_PATH" "$next" || true
}

patch_vscode_config() {
  local path="$1"
  local url="$2"
  local next
  if ! next="$(env TARGET_PATH="$path" MCP_URL="$url" /usr/bin/osascript -l JavaScript <<'EOF'
ObjC.import('Foundation');
const env = $.NSProcessInfo.processInfo.environment;
const path = env.objectForKey('TARGET_PATH').js;
const url = env.objectForKey('MCP_URL').js;
const fm = $.NSFileManager.defaultManager;
let obj = {};
if (fm.fileExistsAtPath(path)) {
  const data = $.NSData.dataWithContentsOfFile(path);
  const text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
  if (text.trim()) obj = JSON.parse(text);
}
obj.servers = obj.servers || {};
obj.servers['mcp-atlassian'] = { type: 'http', url };
JSON.stringify(obj, null, 2);
EOF
)"
  then
    echo "install-mcp-atlassian: invalid JSON or write failure in '$path'. Fix the JSON or pass a clean config path." >&2
    exit 1
  fi
  write_file_if_changed "$path" "$next" || true
}

patch_copilot_config() {
  local path="$1"
  local url="$2"
  local next
  if ! next="$(env TARGET_PATH="$path" MCP_URL="$url" /usr/bin/osascript -l JavaScript <<'EOF'
ObjC.import('Foundation');
const env = $.NSProcessInfo.processInfo.environment;
const path = env.objectForKey('TARGET_PATH').js;
const url = env.objectForKey('MCP_URL').js;
const fm = $.NSFileManager.defaultManager;
let obj = {};
if (fm.fileExistsAtPath(path)) {
  const data = $.NSData.dataWithContentsOfFile(path);
  const text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
  if (text.trim()) obj = JSON.parse(text);
}
obj.mcpServers = obj.mcpServers || {};
obj.mcpServers['mcp-atlassian'] = { type: 'http', url, tools: ['*'] };
JSON.stringify(obj, null, 2);
EOF
)"
  then
    echo "install-mcp-atlassian: invalid JSON or write failure in '$path'. Fix the JSON or pass a clean config path." >&2
    exit 1
  fi
  write_file_if_changed "$path" "$next" || true
}

patch_codex_config() {
  local path="$1"
  local url="$2"
  local next
  next="$(env TARGET_PATH="$path" MCP_URL="$url" /usr/bin/osascript -l JavaScript <<'EOF'
ObjC.import('Foundation');
const env = $.NSProcessInfo.processInfo.environment;
const path = env.objectForKey('TARGET_PATH').js;
const url = env.objectForKey('MCP_URL').js;
const fm = $.NSFileManager.defaultManager;
let text = '';
if (fm.fileExistsAtPath(path)) {
  const data = $.NSData.dataWithContentsOfFile(path);
  text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
}
const block = `[mcp_servers.atlassian]
url = "${url}"
enabled = true
tool_timeout_sec = 120
`;
const removeBlock = (input, header) => {
  const lines = input.split(/\r?\n/);
  const out = [];
  let skipping = false;
  for (const line of lines) {
    if (/^\s*\[.*\]\s*$/.test(line)) {
      skipping = line.trim() === header;
      if (skipping) continue;
    }
    if (!skipping) out.push(line);
  }
  return out.join('\n').replace(/\n{3,}/g, '\n\n').trim();
};
let next = removeBlock(text, '[mcp_servers.atlassian]');
next = next ? `${next}\n\n${block}` : block;
next;
EOF
)"
  write_file_if_changed "$path" "$next" || true
}

PORT="$(select_port)"
URL="http://127.0.0.1:$PORT/mcp"
write_registry "$PORT"
printf "%s" "$PORT" > "$PORT_PATH"

cat > "$SERVER_DIR/start.sh" <<EOF
#!/usr/bin/env zsh
set -eu
UVX_PATH="$UVX_PATH"
EOF

cat >> "$SERVER_DIR/start.sh" <<'EOF'

SERVER_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
BASE_DIR="$(dirname -- "$SERVER_DIR")"
ENV_PATH="$SERVER_DIR/.env"
PORT_PATH="$SERVER_DIR/port"
REGISTRY_PATH="$BASE_DIR/registry.json"

if [ ! -f "$ENV_PATH" ]; then
  echo "start.sh: .env is missing at $ENV_PATH" >&2
  exit 1
fi

set -a
source "$ENV_PATH"
set +a

for key in JIRA_URL JIRA_USERNAME JIRA_API_TOKEN TOOLSETS READ_ONLY_MODE; do
  value="${(P)key:-}"
  if [ -z "$value" ]; then
    echo "start.sh: required environment variable '$key' is missing in $ENV_PATH" >&2
    exit 1
  fi
done

if [ -f "$PORT_PATH" ]; then
  PORT="$(cat "$PORT_PATH")"
elif [ -f "$REGISTRY_PATH" ]; then
  PORT="$(/usr/bin/osascript -l JavaScript <<EOS
ObjC.import('Foundation');
const data = $.NSData.dataWithContentsOfFile('$REGISTRY_PATH');
const text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
const obj = JSON.parse(text);
String(obj.servers['mcp-atlassian'].port);
EOS
)"
else
  echo "start.sh: no port file or registry found" >&2
  exit 1
fi

exec "$UVX_PATH" mcp-atlassian --transport streamable-http --host 127.0.0.1 --port "$PORT" -v
EOF

cat > "$SERVER_DIR/stop.sh" <<EOF
#!/usr/bin/env zsh
set -eu
LABEL="$LABEL"
PLIST_PATH="$PLIST_PATH"
if launchctl print "gui/\$(id -u)/\$LABEL" >/dev/null 2>&1; then
  launchctl bootout "gui/\$(id -u)" "\$PLIST_PATH"
else
  echo "LaunchAgent \$LABEL is not loaded. No tracked service to stop."
fi
EOF

cat > "$SERVER_DIR/status.sh" <<EOF
#!/usr/bin/env zsh
set -eu
LABEL="$LABEL"
SERVER_DIR="$SERVER_DIR"
BASE_DIR="$BASE_DIR"
PORT_PATH="\$SERVER_DIR/port"
REGISTRY_PATH="\$BASE_DIR/registry.json"

if launchctl print "gui/\$(id -u)/\$LABEL" >/dev/null 2>&1; then
  launchctl print "gui/\$(id -u)/\$LABEL"
else
  echo "LaunchAgent: not loaded"
fi

if [ -f "\$PORT_PATH" ]; then
  PORT="\$(cat "\$PORT_PATH")"
elif [ -f "\$REGISTRY_PATH" ]; then
  PORT="\$(/usr/bin/osascript -l JavaScript <<EOS
ObjC.import('Foundation');
const data = $.NSData.dataWithContentsOfFile('\$REGISTRY_PATH');
const text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
const obj = JSON.parse(text);
String(obj.servers['mcp-atlassian'].port);
EOS
)"
else
  PORT=""
fi

if [ -n "\$PORT" ]; then
  echo "URL: http://127.0.0.1:\$PORT/mcp"
  if nc -z 127.0.0.1 "\$PORT" >/dev/null 2>&1; then
    echo "Port listening: true"
  else
    echo "Port listening: false"
  fi
fi
EOF

cat > "$SERVER_DIR/uninstall.sh" <<'EOF'
#!/usr/bin/env zsh
set -eu

REMOVE_LOGS=0
REMOVE_RUNTIME=0
VSCODE_MCP_CONFIG_PATH=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --remove-logs)
      REMOVE_LOGS=1
      shift
      ;;
    --remove-runtime)
      REMOVE_RUNTIME=1
      shift
      ;;
    --vscode-mcp-config-path)
      VSCODE_MCP_CONFIG_PATH="${2:-}"
      shift 2
      ;;
    *)
      echo "uninstall.sh: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

LABEL="dev.binarymisfit.mcp.atlassian"
SERVER_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
BASE_DIR="$(dirname -- "$SERVER_DIR")"
REGISTRY_PATH="$BASE_DIR/registry.json"
ENV_PATH="$SERVER_DIR/.env"
LOG_DIR="$SERVER_DIR/logs"
PLIST_PATH="$HOME/Library/LaunchAgents/$LABEL.plist"
VSCODE_PATH="${VSCODE_MCP_CONFIG_PATH:-$HOME/Library/Application Support/Code/User/mcp.json}"
COPILOT_BASE="${COPILOT_HOME:-$HOME/.copilot}"
COPILOT_PATH="$COPILOT_BASE/mcp-config.json"
CODEX_PATH="${CODEX_HOME:-$HOME/.codex}/config.toml"

if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
  launchctl bootout "gui/$(id -u)" "$PLIST_PATH"
fi
rm -f "$PLIST_PATH"

prune_backups() {
  local path="$1"
  local keep="${2:-5}"
  local dir="${path:h}"
  local leaf="${path:t}"
  local -a backups
  [ -d "$dir" ] || return 0
  backups=("${(@f)$(find "$dir" -maxdepth 1 -type f -name "$leaf.bak.*" -print 2>/dev/null | sort -r)}")
  local count="${#backups[@]}"
  [ "$count" -le "$keep" ] && return 0
  local idx
  for idx in $(seq $((keep + 1)) "$count"); do
    rm -f "$backups[$idx]" 2>/dev/null || echo "uninstall.sh: warning: failed to prune backup '$backups[$idx]'." >&2
  done
}

backup_file_if_changing() {
  local path="$1"
  local new_text="$2"
  [ -f "$path" ] || return 1
  [ "$(cat "$path")" = "$new_text" ] && return 1
  cp "$path" "$path.bak.$(date +%Y%m%d%H%M%S)"
}

write_file_if_changed() {
  local path="$1"
  local new_text="$2"
  if [ -f "$path" ] && [ "$(cat "$path")" = "$new_text" ]; then
    return 1
  fi
  mkdir -p "${path:h}"
  local backed_up=0
  if backup_file_if_changing "$path" "$new_text"; then
    backed_up=1
  fi
  printf "%s" "$new_text" > "$path"
  if [ "$backed_up" -eq 1 ]; then
    prune_backups "$path"
  fi
}

remove_json_entry() {
  local path="$1"
  local top="$2"
  [ -f "$path" ] || return 0
  local next
  next="$(TARGET_PATH="$path" TOP="$top" /usr/bin/osascript -l JavaScript <<'EOS'
ObjC.import('Foundation');
const env = $.NSProcessInfo.processInfo.environment;
const path = env.objectForKey('TARGET_PATH').js;
const top = env.objectForKey('TOP').js;
const data = $.NSData.dataWithContentsOfFile(path);
const text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
const obj = text.trim() ? JSON.parse(text) : {};
let changed = false;
if (obj[top] && Object.prototype.hasOwnProperty.call(obj[top], 'mcp-atlassian')) {
  delete obj[top]['mcp-atlassian'];
  changed = true;
}
changed ? `__MCP_CHANGED__${JSON.stringify(obj, null, 2)}` : '';
EOS
)"
  [[ "$next" == __MCP_CHANGED__* ]] || return 0
  next="${next#__MCP_CHANGED__}"
  write_file_if_changed "$path" "$next" || true
}

remove_json_entry "$VSCODE_PATH" "servers"
remove_json_entry "$COPILOT_PATH" "mcpServers"
remove_json_entry "$REGISTRY_PATH" "servers"

if [ -f "$CODEX_PATH" ]; then
  next="$(TARGET_PATH="$CODEX_PATH" /usr/bin/osascript -l JavaScript <<'EOS'
ObjC.import('Foundation');
const path = $.NSProcessInfo.processInfo.environment.objectForKey('TARGET_PATH').js;
const data = $.NSData.dataWithContentsOfFile(path);
const text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
const lines = text.split(/\r?\n/);
const out = [];
let skipping = false;
for (const line of lines) {
  if (/^\s*\[.*\]\s*$/.test(line)) {
    skipping = line.trim() === '[mcp_servers.atlassian]';
    if (skipping) continue;
  }
  if (!skipping) out.push(line);
}
const next = out.join('\n').replace(/\n{3,}/g, '\n\n').trim();
next !== text ? `__MCP_CHANGED__${next}` : '';
EOS
)"
  [[ "$next" == __MCP_CHANGED__* ]] || return 0
  next="${next#__MCP_CHANGED__}"
  write_file_if_changed "$CODEX_PATH" "$next" || true
fi

if [ -f "$ENV_PATH" ]; then
  backup="$SERVER_DIR/.env.backup"
  if [ -e "$backup" ]; then
    backup="$SERVER_DIR/.env.backup.$(date +%Y%m%d%H%M%S)"
  fi
  mv "$ENV_PATH" "$backup"
fi

if [ "$REMOVE_LOGS" -eq 1 ]; then
  rm -rf "$LOG_DIR"
fi

if [ "$REMOVE_RUNTIME" -eq 1 ]; then
  rm -rf "$SERVER_DIR"
fi

echo "mcp-atlassian uninstalled. .env preserved as backup when present. Logs retained unless --remove-logs was passed."
EOF

cat > "$PLIST_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>$SERVER_DIR/start.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$SERVER_DIR</string>
  <key>StandardOutPath</key>
  <string>$LOG_DIR/mcp-atlassian.log</string>
  <key>StandardErrorPath</key>
  <string>$LOG_DIR/mcp-atlassian.log</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
EOF

cp "$PLIST_PATH" "$SERVER_DIR/$LABEL.plist"
chmod +x "$SERVER_DIR/start.sh" "$SERVER_DIR/stop.sh" "$SERVER_DIR/status.sh" "$SERVER_DIR/uninstall.sh"

if agent_is_loaded; then
  launchctl bootout "gui/$(id -u)" "$PLIST_PATH"
fi
launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH"
launchctl kickstart -k "gui/$(id -u)/$LABEL"

VSCODE_PATH="${VSCODE_MCP_CONFIG_PATH:-$HOME/Library/Application Support/Code/User/mcp.json}"
COPILOT_BASE="${COPILOT_HOME:-$HOME/.copilot}"
COPILOT_PATH="$COPILOT_BASE/mcp-config.json"
CODEX_PATH="${CODEX_HOME:-$HOME/.codex}/config.toml"

patch_vscode_config "$VSCODE_PATH" "$URL"
patch_copilot_config "$COPILOT_PATH" "$URL"
patch_codex_config "$CODEX_PATH" "$URL"

if agent_is_loaded; then
  SERVICE_STATE="loaded"
else
  SERVICE_STATE="not loaded"
fi

echo "name: mcp-atlassian"
echo "port: $PORT"
echo "URL: $URL"
echo "env path: $ENV_PATH"
echo "logs path: $LOG_DIR"
echo "service state: $SERVICE_STATE"
echo "clients patched: VS Code ($VSCODE_PATH), Copilot CLI ($COPILOT_PATH), Codex ($CODEX_PATH)"
echo "status: $SERVER_DIR/status.sh"
