#!powershell
[CmdletBinding()]
param(
    [string]$McpVSCodeConfigPath
)

$ErrorActionPreference = "Stop"

$IsWindowsPlatform = ($PSVersionTable.PSEdition -eq "Desktop") -or ($IsWindows -eq $true)
if (-not $IsWindowsPlatform) {
    Write-Error "install-mcp-atlassian: Windows installer only. macOS uses install-mcp-atlassian.sh; Linux is intentionally out of scope."
}

function Test-IsAdmin {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = [Security.Principal.WindowsPrincipal]::new($identity)
    return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

function Get-CommandPath([string]$Name) {
    $cmd = Get-Command $Name -ErrorAction SilentlyContinue
    if ($cmd) { return $cmd.Source }
    return $null
}

function Resolve-VSCodeMcpConfigPath([string]$McpVSCodeConfigPath) {
    if ($McpVSCodeConfigPath) { return $McpVSCodeConfigPath }

    $scoopData = Join-Path $env:USERPROFILE "scoop\persist\vscode\data\user-data\User"
    $scoopExe = Join-Path $env:USERPROFILE "scoop\apps\vscode\current\Code.exe"
    if ((Test-Path -LiteralPath $scoopData) -and (Test-Path -LiteralPath $scoopExe)) {
        return (Join-Path $scoopData "mcp.json")
    }

    return (Join-Path $env:APPDATA "Code\User\mcp.json")
}

function Read-JsonFile([string]$Path, [object]$Default) {
    if (-not (Test-Path -LiteralPath $Path)) { return $Default }
    $raw = Get-Content -LiteralPath $Path -Raw
    if ([string]::IsNullOrWhiteSpace($raw)) { return $Default }
    try {
        return $raw | ConvertFrom-Json -Depth 32
    } catch {
        Write-Error "Invalid JSON in '$Path'. Fix the JSON or pass a clean config path. $($_.Exception.Message)"
    }
}

function Prune-Backups([string]$Path, [int]$Keep = 5) {
    try {
        $dir = Split-Path -Parent $Path
        if (-not $dir -or -not (Test-Path -LiteralPath $dir)) { return }
        $leaf = Split-Path -Leaf $Path
        Get-ChildItem -LiteralPath $dir -File -Filter "$leaf.bak.*" |
            Sort-Object LastWriteTimeUtc -Descending |
            Select-Object -Skip $Keep |
            Remove-Item -Force -ErrorAction Stop
    } catch {
        Write-Warning "Failed to prune backups for '$Path'. $($_.Exception.Message)"
    }
}

function Backup-FileIfChanging([string]$Path, [string]$NewContent) {
    if (-not (Test-Path -LiteralPath $Path)) { return $false }
    $old = Get-Content -LiteralPath $Path -Raw
    if ($old -eq $NewContent) { return $false }
    $stamp = Get-Date -Format "yyyyMMddHHmmss"
    Copy-Item -LiteralPath $Path -Destination "$Path.bak.$stamp" -Force
    return $true
}

function Write-FileIfChanged([string]$Path, [string]$Text, [System.Text.Encoding]$Encoding = [System.Text.UTF8Encoding]::new($false)) {
    if ((Test-Path -LiteralPath $Path) -and ((Get-Content -LiteralPath $Path -Raw) -eq $Text)) { return $false }
    $dir = Split-Path -Parent $Path
    if ($dir) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
    $backedUp = Backup-FileIfChanging $Path $Text
    [System.IO.File]::WriteAllText($Path, $Text, $Encoding)
    if ($backedUp) { Prune-Backups $Path }
    return $true
}

function Write-JsonFileIfChanged([string]$Path, [object]$Data) {
    Write-FileIfChanged $Path ($Data | ConvertTo-Json -Depth 32)
}

function Ensure-ObjectProperty([object]$Object, [string]$Name, [object]$Value) {
    if ($Object.PSObject.Properties.Name -contains $Name) {
        $Object.$Name = $Value
    } else {
        $Object | Add-Member -NotePropertyName $Name -NotePropertyValue $Value
    }
}

function Test-PortOpen([int]$Port) {
    $client = [Net.Sockets.TcpClient]::new()
    try {
        $async = $client.BeginConnect("127.0.0.1", $Port, $null, $null)
        if (-not $async.AsyncWaitHandle.WaitOne(200)) { return $false }
        $client.EndConnect($async)
        return $true
    } catch {
        return $false
    } finally {
        $client.Close()
    }
}

function Test-ServiceExists([string]$Name) {
    return [bool](Get-Service -Name $Name -ErrorAction SilentlyContinue)
}

function Stop-McpAtlassianService([string]$ServiceName) {
    $service = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
    if (-not $service) { return }

    $stop = Start-Process -FilePath "nssm" -ArgumentList @("stop", $ServiceName) -PassThru
    $deadline = (Get-Date).AddSeconds(10)
    while ((Get-Date) -lt $deadline) {
        $service.Refresh()
        if ($service.Status -eq [System.ServiceProcess.ServiceControllerStatus]::Stopped) { break }
        Start-Sleep -Milliseconds 250
    }
    if (-not $stop.HasExited) {
        Stop-Process -Id $stop.Id -Force -ErrorAction SilentlyContinue
    }
    $service.Refresh()

    if ($service.Status -ne [System.ServiceProcess.ServiceControllerStatus]::Stopped) {
        Write-Warning "$ServiceName did not stop within 10 seconds. Killing only tracked mcp-atlassian process matches."
        Get-CimInstance Win32_Process |
            Where-Object {
                $_.ProcessId -ne $PID -and $_.CommandLine -and (
                    $_.CommandLine -like "*mcp-atlassian*" -or
                    $_.CommandLine -like "*MCP\atlassian\start.ps1*"
                )
            } |
            ForEach-Object {
                try {
                    Stop-Process -Id $_.ProcessId -Force -ErrorAction Stop
                } catch {
                    Write-Warning "Failed to stop PID $($_.ProcessId): $($_.Exception.Message)"
                }
            }
        $service.Refresh()
    }
}

function Select-McpPort([object]$Registry, [string]$ServiceName) {
    $existing = $null
    if ($Registry.servers -and $Registry.servers.'mcp-atlassian' -and $Registry.servers.'mcp-atlassian'.port) {
        $existing = [int]$Registry.servers.'mcp-atlassian'.port
    }

    if ($existing) {
        if (-not (Test-PortOpen $existing)) { return $existing }
        $svc = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
        if ($svc -and $svc.Status -eq "Running") { return $existing }
    }

    if (-not (Test-PortOpen 9310)) { return 9310 }

    foreach ($port in 9311..9399) {
        if (-not (Test-PortOpen $port)) { return $port }
    }

    Write-Error "No available ports in deterministic range 9310-9399."
}

function Patch-VSCodeConfig([string]$Path, [string]$Url) {
    $config = Read-JsonFile $Path ([pscustomobject]@{})
    if (-not ($config.PSObject.Properties.Name -contains "servers") -or $null -eq $config.servers) {
        Ensure-ObjectProperty $config "servers" ([pscustomobject]@{})
    }
    Ensure-ObjectProperty $config.servers "mcp-atlassian" ([pscustomobject]@{
        type = "http"
        url = $Url
    })
    Write-JsonFileIfChanged $Path $config | Out-Null
}

function Patch-CopilotConfig([string]$Path, [string]$Url) {
    $config = Read-JsonFile $Path ([pscustomobject]@{})
    if (-not ($config.PSObject.Properties.Name -contains "mcpServers") -or $null -eq $config.mcpServers) {
        Ensure-ObjectProperty $config "mcpServers" ([pscustomobject]@{})
    }
    Ensure-ObjectProperty $config.mcpServers "mcp-atlassian" ([pscustomobject]@{
        type = "http"
        url = $Url
        tools = @("*")
    })
    Write-JsonFileIfChanged $Path $config | Out-Null
}

function Remove-TomlBlock([string]$Text, [string]$Header) {
    $lines = $Text -split "`r?`n"
    $out = New-Object System.Collections.Generic.List[string]
    $skipping = $false
    foreach ($line in $lines) {
        if ($line -match '^\s*\[.*\]\s*$') {
            $skipping = ($line.Trim() -eq $Header)
            if ($skipping) { continue }
        }
        if (-not $skipping) { $out.Add($line) }
    }
    return (($out -join "`n") -replace "`n{3,}", "`n`n").Trim()
}

function Patch-CodexConfig([string]$Path, [string]$Url) {
    $text = ""
    if (Test-Path -LiteralPath $Path) {
        $text = Get-Content -LiteralPath $Path -Raw
    }
    $next = Remove-TomlBlock $text "[mcp_servers.atlassian]"
    $block = @"
[mcp_servers.atlassian]
url = "$Url"
enabled = true
tool_timeout_sec = 120
"@
    if ($next) { $next = "$next`n`n$block" } else { $next = $block }
    Write-FileIfChanged $Path $next | Out-Null
}

if (-not (Test-IsAdmin)) {
    Write-Error "Creating or updating the NSSM service requires elevation. Rerun PowerShell as Administrator; no service changes were made."
}

$BaseDir = Join-Path $env:LOCALAPPDATA "MCP"
$ServerDir = Join-Path $BaseDir "atlassian"
$LogDir = Join-Path $ServerDir "logs"
$RegistryPath = Join-Path $BaseDir "registry.json"
$PortPath = Join-Path $ServerDir "port"
$EnvPath = Join-Path $ServerDir ".env"
$ServiceName = "MCP-Atlassian"
$EnvExamplePath = Join-Path $env:USERPROFILE ".config\mcp\mcp-atlassian.env.example"

New-Item -ItemType Directory -Force -Path $BaseDir, $ServerDir, $LogDir | Out-Null

$uvxPath = Get-CommandPath "uvx"
if (-not $uvxPath) {
    Write-Error "uvx was not found after installing uv. Check Scoop/Winget install."
}
if (-not (Get-CommandPath "nssm")) {
    Write-Error "Required command 'nssm' was not found. Install NSSM manually, then rerun; this installer does not auto-install dependencies."
}

if (-not (Test-Path -LiteralPath $EnvPath)) {
    if (-not (Test-Path -LiteralPath $EnvExamplePath)) {
        Write-Error "Env example not found at '$EnvExamplePath'. Run chezmoi apply or create $EnvPath manually."
    }
    Copy-Item -LiteralPath $EnvExamplePath -Destination $EnvPath
}

$registry = Read-JsonFile $RegistryPath ([pscustomobject]@{
    range = [pscustomobject]@{ start = 9310; end = 9399 }
    servers = [pscustomobject]@{}
})
Ensure-ObjectProperty $registry "range" ([pscustomobject]@{ start = 9310; end = 9399 })
if (-not ($registry.PSObject.Properties.Name -contains "servers") -or $null -eq $registry.servers) {
    Ensure-ObjectProperty $registry "servers" ([pscustomobject]@{})
}

$port = Select-McpPort $registry $ServiceName
$url = "http://127.0.0.1:$port/mcp"
Ensure-ObjectProperty $registry.servers "mcp-atlassian" ([pscustomobject]@{
    port = $port
    url = $url
    transport = "streamable-http"
})
Write-JsonFileIfChanged $RegistryPath $registry | Out-Null
$port.ToString() | Set-Content -LiteralPath $PortPath -NoNewline -Encoding ASCII

$startPath = Join-Path $ServerDir "start.ps1"
$stopPath = Join-Path $ServerDir "stop.ps1"
$statusPath = Join-Path $ServerDir "status.ps1"
$uninstallPath = Join-Path $ServerDir "uninstall.ps1"

@'
$ErrorActionPreference = "Stop"
$UvxPath = '__UVX_PATH__'
$ServerDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$BaseDir = Split-Path -Parent $ServerDir
$EnvPath = Join-Path $ServerDir ".env"
$PortPath = Join-Path $ServerDir "port"
$RegistryPath = Join-Path $BaseDir "registry.json"

if (-not (Test-Path -LiteralPath $EnvPath)) {
    Write-Error ".env is missing at $EnvPath"
}

foreach ($line in Get-Content -LiteralPath $EnvPath) {
    $trimmed = $line.Trim()
    if ($trimmed -eq "" -or $trimmed.StartsWith("#")) { continue }
    $idx = $trimmed.IndexOf("=")
    if ($idx -lt 1) { continue }
    $key = $trimmed.Substring(0, $idx).Trim()
    $value = $trimmed.Substring($idx + 1).Trim().Trim('"').Trim("'")
    [Environment]::SetEnvironmentVariable($key, $value, "Process")
}

$required = @("JIRA_URL", "JIRA_USERNAME", "JIRA_API_TOKEN", "TOOLSETS", "READ_ONLY_MODE")
foreach ($key in $required) {
    if ([string]::IsNullOrWhiteSpace([Environment]::GetEnvironmentVariable($key, "Process"))) {
        Write-Error "Required environment variable '$key' is missing in $EnvPath"
    }
}

if (Test-Path -LiteralPath $PortPath) {
    $port = [int](Get-Content -LiteralPath $PortPath -Raw).Trim()
} elseif (Test-Path -LiteralPath $RegistryPath) {
    $registry = Get-Content -LiteralPath $RegistryPath -Raw | ConvertFrom-Json
    $port = [int]$registry.servers.'mcp-atlassian'.port
} else {
    Write-Error "No port file or registry found."
}

& $UvxPath mcp-atlassian --transport streamable-http --host 127.0.0.1 --port $port -v
exit $LASTEXITCODE
'@.Replace('__UVX_PATH__', $uvxPath.Replace("'", "''")) | Set-Content -LiteralPath $startPath -Encoding UTF8

@'
$ErrorActionPreference = "Stop"
$ServiceName = "MCP-Atlassian"

function Stop-McpAtlassianService([string]$ServiceName) {
    $service = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
    if (-not $service) {
        Write-Host "NSSM service $ServiceName is not installed. No tracked service to stop."
        return
    }

    $stop = Start-Process -FilePath "nssm" -ArgumentList @("stop", $ServiceName) -PassThru
    $deadline = (Get-Date).AddSeconds(10)
    while ((Get-Date) -lt $deadline) {
        $service.Refresh()
        if ($service.Status -eq [System.ServiceProcess.ServiceControllerStatus]::Stopped) { break }
        Start-Sleep -Milliseconds 250
    }
    if (-not $stop.HasExited) {
        Stop-Process -Id $stop.Id -Force -ErrorAction SilentlyContinue
    }
    $service.Refresh()

    if ($service.Status -ne [System.ServiceProcess.ServiceControllerStatus]::Stopped) {
        Write-Warning "$ServiceName did not stop within 10 seconds. Killing only tracked mcp-atlassian process matches."
        Get-CimInstance Win32_Process |
            Where-Object {
                $_.ProcessId -ne $PID -and $_.CommandLine -and (
                    $_.CommandLine -like "*mcp-atlassian*" -or
                    $_.CommandLine -like "*MCP\atlassian\start.ps1*"
                )
            } |
            ForEach-Object {
                try {
                    Stop-Process -Id $_.ProcessId -Force -ErrorAction Stop
                } catch {
                    Write-Warning "Failed to stop PID $($_.ProcessId): $($_.Exception.Message)"
                }
            }
        $service.Refresh()
    }
}

if (Get-Service -Name $ServiceName -ErrorAction SilentlyContinue) {
    Stop-McpAtlassianService $ServiceName
} else {
    Write-Host "NSSM service $ServiceName is not installed. No tracked service to stop."
}
'@ | Set-Content -LiteralPath $stopPath -Encoding UTF8

@'
$ErrorActionPreference = "Stop"
$ServerDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$BaseDir = Split-Path -Parent $ServerDir
$PortPath = Join-Path $ServerDir "port"
$RegistryPath = Join-Path $BaseDir "registry.json"
$ServiceName = "MCP-Atlassian"

if (Get-Service -Name $ServiceName -ErrorAction SilentlyContinue) {
    & nssm status $ServiceName | Out-Host
} else {
    Write-Host "Service: not installed"
}

if (Test-Path -LiteralPath $PortPath) {
    $port = [int](Get-Content -LiteralPath $PortPath -Raw).Trim()
} elseif (Test-Path -LiteralPath $RegistryPath) {
    $registry = Get-Content -LiteralPath $RegistryPath -Raw | ConvertFrom-Json
    $port = [int]$registry.servers.'mcp-atlassian'.port
}

if ($port) {
    $url = "http://127.0.0.1:$port/mcp"
    Write-Host "URL: $url"
    $client = [Net.Sockets.TcpClient]::new()
    try {
        $async = $client.BeginConnect("127.0.0.1", $port, $null, $null)
        $listening = $async.AsyncWaitHandle.WaitOne(300)
        if ($listening) { $client.EndConnect($async) }
        Write-Host "Port listening: $listening"
    } catch {
        Write-Host "Port listening: False"
    } finally {
        $client.Close()
    }
}
'@ | Set-Content -LiteralPath $statusPath -Encoding UTF8

@'
[CmdletBinding()]
param([switch]$RemoveLogs, [switch]$RemoveRuntime, [string]$McpVSCodeConfigPath)
$ErrorActionPreference = "Stop"

function Read-JsonFile([string]$Path, [object]$Default) {
    if (-not (Test-Path -LiteralPath $Path)) { return $Default }
    $raw = Get-Content -LiteralPath $Path -Raw
    if ([string]::IsNullOrWhiteSpace($raw)) { return $Default }
    return $raw | ConvertFrom-Json -Depth 32
}

function Prune-Backups([string]$Path, [int]$Keep = 5) {
    try {
        $dir = Split-Path -Parent $Path
        if (-not $dir -or -not (Test-Path -LiteralPath $dir)) { return }
        $leaf = Split-Path -Leaf $Path
        Get-ChildItem -LiteralPath $dir -File -Filter "$leaf.bak.*" |
            Sort-Object LastWriteTimeUtc -Descending |
            Select-Object -Skip $Keep |
            Remove-Item -Force -ErrorAction Stop
    } catch {
        Write-Warning "Failed to prune backups for '$Path'. $($_.Exception.Message)"
    }
}

function Backup-FileIfChanging([string]$Path, [string]$NewContent) {
    if (-not (Test-Path -LiteralPath $Path)) { return $false }
    $old = Get-Content -LiteralPath $Path -Raw
    if ($old -eq $NewContent) { return $false }
    $stamp = Get-Date -Format "yyyyMMddHHmmss"
    Copy-Item -LiteralPath $Path -Destination "$Path.bak.$stamp" -Force
    return $true
}

function Write-FileIfChanged([string]$Path, [string]$Text, [System.Text.Encoding]$Encoding = [System.Text.UTF8Encoding]::new($false)) {
    if ((Test-Path -LiteralPath $Path) -and ((Get-Content -LiteralPath $Path -Raw) -eq $Text)) { return $false }
    $dir = Split-Path -Parent $Path
    if ($dir) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
    $backedUp = Backup-FileIfChanging $Path $Text
    [System.IO.File]::WriteAllText($Path, $Text, $Encoding)
    if ($backedUp) { Prune-Backups $Path }
    return $true
}

function Write-JsonFileIfChanged([string]$Path, [object]$Data) {
    Write-FileIfChanged $Path ($Data | ConvertTo-Json -Depth 32)
}

function Remove-TomlBlock([string]$Text, [string]$Header) {
    $lines = $Text -split "`r?`n"
    $out = New-Object System.Collections.Generic.List[string]
    $skipping = $false
    foreach ($line in $lines) {
        if ($line -match '^\s*\[.*\]\s*$') {
            $skipping = ($line.Trim() -eq $Header)
            if ($skipping) { continue }
        }
        if (-not $skipping) { $out.Add($line) }
    }
    return (($out -join "`n") -replace "`n{3,}", "`n`n").Trim()
}

function Remove-Property([object]$Object, [string]$Name) {
    if ($Object -and ($Object.PSObject.Properties.Name -contains $Name)) {
        $Object.PSObject.Properties.Remove($Name)
    }
}

function Resolve-VSCodeMcpConfigPath([string]$McpVSCodeConfigPath) {
    if ($McpVSCodeConfigPath) { return $McpVSCodeConfigPath }

    $scoopData = Join-Path $env:USERPROFILE "scoop\persist\vscode\data\user-data\User"
    $scoopExe = Join-Path $env:USERPROFILE "scoop\apps\vscode\current\Code.exe"
    if ((Test-Path -LiteralPath $scoopData) -and (Test-Path -LiteralPath $scoopExe)) {
        return (Join-Path $scoopData "mcp.json")
    }

    return (Join-Path $env:APPDATA "Code\User\mcp.json")
}

function Stop-McpAtlassianService([string]$ServiceName) {
    $service = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
    if (-not $service) { return }

    $stop = Start-Process -FilePath "nssm" -ArgumentList @("stop", $ServiceName) -PassThru
    $deadline = (Get-Date).AddSeconds(10)
    while ((Get-Date) -lt $deadline) {
        $service.Refresh()
        if ($service.Status -eq [System.ServiceProcess.ServiceControllerStatus]::Stopped) { break }
        Start-Sleep -Milliseconds 250
    }
    if (-not $stop.HasExited) {
        Stop-Process -Id $stop.Id -Force -ErrorAction SilentlyContinue
    }
    $service.Refresh()

    if ($service.Status -ne [System.ServiceProcess.ServiceControllerStatus]::Stopped) {
        Write-Warning "$ServiceName did not stop within 10 seconds. Killing only tracked mcp-atlassian process matches."
        Get-CimInstance Win32_Process |
            Where-Object {
                $_.ProcessId -ne $PID -and $_.CommandLine -and (
                    $_.CommandLine -like "*mcp-atlassian*" -or
                    $_.CommandLine -like "*MCP\atlassian\start.ps1*"
                )
            } |
            ForEach-Object {
                try {
                    Stop-Process -Id $_.ProcessId -Force -ErrorAction Stop
                } catch {
                    Write-Warning "Failed to stop PID $($_.ProcessId): $($_.Exception.Message)"
                }
            }
        $service.Refresh()
    }
}

$ServerDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$BaseDir = Split-Path -Parent $ServerDir
$RegistryPath = Join-Path $BaseDir "registry.json"
$EnvPath = Join-Path $ServerDir ".env"
$LogDir = Join-Path $ServerDir "logs"
$ServiceName = "MCP-Atlassian"

if (Get-Service -Name $ServiceName -ErrorAction SilentlyContinue) {
    Stop-McpAtlassianService $ServiceName
    & nssm remove $ServiceName confirm | Out-Host
}

$vscode = Resolve-VSCodeMcpConfigPath $McpVSCodeConfigPath
$copilotHome = if ($env:COPILOT_HOME) { $env:COPILOT_HOME } else { Join-Path $env:USERPROFILE ".copilot" }
$copilot = Join-Path $copilotHome "mcp-config.json"
$codexHome = if ($env:CODEX_HOME) { $env:CODEX_HOME } else { Join-Path $env:USERPROFILE ".codex" }
$codex = Join-Path $codexHome "config.toml"

if (Test-Path -LiteralPath $vscode) {
    $cfg = Read-JsonFile $vscode ([pscustomobject]@{})
    if ($cfg.servers) { Remove-Property $cfg.servers "mcp-atlassian" }
    Write-JsonFileIfChanged $vscode $cfg | Out-Null
}

if (Test-Path -LiteralPath $copilot) {
    $cfg = Read-JsonFile $copilot ([pscustomobject]@{})
    if ($cfg.mcpServers) { Remove-Property $cfg.mcpServers "mcp-atlassian" }
    Write-JsonFileIfChanged $copilot $cfg | Out-Null
}

if (Test-Path -LiteralPath $codex) {
    $text = Get-Content -LiteralPath $codex -Raw
    Write-FileIfChanged $codex (Remove-TomlBlock $text "[mcp_servers.atlassian]") | Out-Null
}

if (Test-Path -LiteralPath $RegistryPath) {
    $registry = Read-JsonFile $RegistryPath ([pscustomobject]@{})
    if ($registry.servers) { Remove-Property $registry.servers "mcp-atlassian" }
    Write-JsonFileIfChanged $RegistryPath $registry | Out-Null
}

if (Test-Path -LiteralPath $EnvPath) {
    $envBackup = Join-Path $ServerDir ".env.backup"
    if (Test-Path -LiteralPath $envBackup) {
        $stamp = Get-Date -Format "yyyyMMddHHmmss"
        $envBackup = Join-Path $ServerDir ".env.backup.$stamp"
    }
    Move-Item -LiteralPath $EnvPath -Destination $envBackup
}

if ($RemoveLogs) {
    Remove-Item -LiteralPath $LogDir -Recurse -Force -ErrorAction SilentlyContinue
}

if ($RemoveRuntime) {
    Remove-Item -LiteralPath $ServerDir -Recurse -Force -ErrorAction SilentlyContinue
}

Write-Host "mcp-atlassian uninstalled. .env preserved as backup when present. Logs retained unless -RemoveLogs was passed."
'@ | Set-Content -LiteralPath $uninstallPath -Encoding UTF8

$pwsh = Get-CommandPath "pwsh.exe"
if (-not $pwsh) { $pwsh = Get-CommandPath "pwsh" }
if (-not $pwsh) {
    Write-Error "pwsh.exe was not found. Install PowerShell 7, then rerun as Administrator."
}

if (Test-ServiceExists $ServiceName) {
    Stop-McpAtlassianService $ServiceName
} else {
    & nssm install $ServiceName $pwsh "-NoProfile -ExecutionPolicy Bypass -File `"$startPath`"" | Out-Null
}

& nssm set $ServiceName Application $pwsh | Out-Null
& nssm set $ServiceName AppParameters "-NoProfile -ExecutionPolicy Bypass -File `"$startPath`"" | Out-Null
& nssm set $ServiceName AppDirectory $ServerDir | Out-Null
& nssm set $ServiceName Start SERVICE_DELAYED_AUTO_START | Out-Null
$serviceLogPath = Join-Path $LogDir "mcp-atlassian.log"
& nssm set $ServiceName AppStdout $serviceLogPath | Out-Null
& nssm set $ServiceName AppStderr $serviceLogPath | Out-Null
& nssm set $ServiceName AppRotateFiles 1 | Out-Null
& nssm set $ServiceName AppRotateOnline 1 | Out-Null
& nssm set $ServiceName AppRotateBytes 10485760 | Out-Null
& nssm set $ServiceName AppExit Default Restart | Out-Null
& nssm set $ServiceName AppStopMethodConsole 1500 | Out-Null
& nssm set $ServiceName AppStopMethodWindow 1500 | Out-Null
& nssm set $ServiceName AppStopMethodThreads 1500 | Out-Null
& nssm set $ServiceName AppKillProcessTree 1 | Out-Null

$vscodePath = Resolve-VSCodeMcpConfigPath $McpVSCodeConfigPath
$copilotHome = if ($env:COPILOT_HOME) { $env:COPILOT_HOME } else { Join-Path $env:USERPROFILE ".copilot" }
$copilotPath = Join-Path $copilotHome "mcp-config.json"
$codexHome = if ($env:CODEX_HOME) { $env:CODEX_HOME } else { Join-Path $env:USERPROFILE ".codex" }
$codexPath = Join-Path $codexHome "config.toml"

Patch-VSCodeConfig $vscodePath $url
Patch-CopilotConfig $copilotPath $url
Patch-CodexConfig $codexPath $url

& nssm start $ServiceName | Out-Host

$service = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
$serviceState = if ($service) { $service.Status } else { "not installed" }

Write-Host "name: mcp-atlassian"
Write-Host "port: $port"
Write-Host "URL: $url"
Write-Host "env path: $EnvPath"
Write-Host "logs path: $LogDir"
Write-Host "service state: $serviceState"
Write-Host "clients patched: VS Code ($vscodePath), Copilot CLI ($copilotPath), Codex ($codexPath)"
Write-Host "status: $statusPath"
