#!/usr/bin/env zsh
set -eu

MEM0_URL="https://mcp.mem0.ai/mcp"
ENV_FILE="$HOME/.config/mcp/mcp-mem0.env"
VSCODE_CONFIG_FILE="${VSCODE_MCP_CONFIG_PATH:-$HOME/Library/Application Support/Code/User/mcp.json}"
COPILOT_BASE_DIR="${COPILOT_HOME:-$HOME/.copilot}"
COPILOT_CONFIG_FILE="$COPILOT_BASE_DIR/mcp-config.json"
CODEX_CONFIG_FILE="${CODEX_HOME:-$HOME/.codex}/config.toml"

env \
  MEM0_URL="$MEM0_URL" \
  MEM0_ENV_FILE="$ENV_FILE" \
  VSCODE_CONFIG_FILE="$VSCODE_CONFIG_FILE" \
  COPILOT_CONFIG_FILE="$COPILOT_CONFIG_FILE" \
  CODEX_CONFIG_FILE="$CODEX_CONFIG_FILE" \
  /usr/bin/python3 <<'PY'
import json
import os
import re
import shutil
from datetime import datetime
from pathlib import Path


MEM0_URL = os.environ["MEM0_URL"]
ENV_FILE = Path(os.environ["MEM0_ENV_FILE"]).expanduser()
VSCODE_CONFIG_FILE = Path(os.environ["VSCODE_CONFIG_FILE"]).expanduser()
COPILOT_CONFIG_FILE = Path(os.environ["COPILOT_CONFIG_FILE"]).expanduser()
CODEX_CONFIG_FILE = Path(os.environ["CODEX_CONFIG_FILE"]).expanduser()


def read_env_file(env_file):
    values = {}
    if not env_file.exists():
        return values
    for raw_line in env_file.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        if key:
            values[key] = value
    return values


def backup_file(target):
    if not target.exists():
        return
    stamp = datetime.now().strftime("%Y%m%d%H%M%S")
    backup = target.with_name(f"{target.name}.bak.{stamp}")
    shutil.copy2(target, backup)


def write_text_if_changed(target, text):
    old = None
    if target.exists():
        old = target.read_text(encoding="utf-8")
    if old == text:
        return False
    target.parent.mkdir(parents=True, exist_ok=True)
    backup_file(target)
    target.write_text(text, encoding="utf-8")
    return True


def read_json(target):
    if not target.exists():
        return {}
    raw = target.read_text(encoding="utf-8")
    if not raw.strip():
        return {}
    try:
        return json.loads(raw)
    except json.JSONDecodeError as exc:
        raise SystemExit(
            f"install-mcp-mem0: invalid JSON in '{target}'. "
            f"Fix the JSON or use a clean config path. {exc}"
        )


def write_json_if_changed(target, data):
    new = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    return write_text_if_changed(target, new)


def mem0_json_entry(has_api_key):
    entry = {
        "type": "http",
        "url": MEM0_URL,
    }
    if has_api_key:
        entry["headers"] = {
            "Authorization": "Token ${MEM0_API_KEY}",
        }
    return entry


def patch_json_config(target, top_key, has_api_key):
    config = read_json(target)
    if not isinstance(config, dict):
        raise SystemExit(f"install-mcp-mem0: top-level JSON in '{target}' must be an object.")
    if not isinstance(config.get(top_key), dict):
        config[top_key] = {}
    config[top_key]["mem0"] = mem0_json_entry(has_api_key)
    write_json_if_changed(target, config)


def remove_toml_table(text, header):
    lines = text.splitlines()
    out = []
    skip = False
    escaped = re.escape(header)
    table_re = re.compile(r"^\s*\[[^\]]+\]\s*$")
    target_re = re.compile(rf"^\s*{escaped}\s*$")
    for line in lines:
        if table_re.match(line):
            skip = bool(target_re.match(line))
            if skip:
                continue
        if not skip:
            out.append(line)
    return re.sub(r"\n{3,}", "\n\n", "\n".join(out)).strip()


def codex_block(has_auth_header):
    block = f'''[mcp_servers.mem0]
url = "{MEM0_URL}"
enabled = true'''
    if has_auth_header:
        block += '''
env_http_headers = { Authorization = "MEM0_AUTH_HEADER" }'''
    return block + "\n"


def patch_codex_config(target, has_auth_header):
    old = target.read_text(encoding="utf-8") if target.exists() else ""
    next_text = remove_toml_table(old, "[mcp_servers.mem0]")
    next_text = remove_toml_table(next_text, "[mcp_servers.mem0.headers]")
    block = codex_block(has_auth_header)
    next_text = f"{next_text}\n\n{block}" if next_text else block
    write_text_if_changed(target, next_text)


env_values = read_env_file(ENV_FILE)
has_api_key = bool(env_values.get("MEM0_API_KEY"))
has_auth_header = bool(env_values.get("MEM0_AUTH_HEADER") or has_api_key)

patch_json_config(VSCODE_CONFIG_FILE, "servers", has_api_key)
patch_json_config(COPILOT_CONFIG_FILE, "mcpServers", has_api_key)
patch_codex_config(CODEX_CONFIG_FILE, has_auth_header)

if has_api_key and not env_values.get("MEM0_AUTH_HEADER"):
    print("install-mcp-mem0: MEM0_API_KEY found; export MEM0_AUTH_HEADER='Token <key>' for Codex API-key auth.")
elif not has_api_key and not env_values.get("MEM0_AUTH_HEADER"):
    print("install-mcp-mem0: no API key found; configured URL-only Mem0 MCP for browser auth.")

print("mem0 MCP configured")
print(f"URL: {MEM0_URL}")
print(f"Env path: {ENV_FILE}")
print(f"VS Code MCP config: {VSCODE_CONFIG_FILE}")
print(f"Copilot MCP config: {COPILOT_CONFIG_FILE}")
print(f"Codex config: {CODEX_CONFIG_FILE}")
PY
