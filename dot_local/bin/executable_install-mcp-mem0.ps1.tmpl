[CmdletBinding()]
param(
    [string]$McpVSCodeConfigPath
)

$ErrorActionPreference = "Stop"

$Mem0Url = "https://mcp.mem0.ai/mcp"
$EnvPath = Join-Path $env:USERPROFILE ".config\mcp\mcp-mem0.env"
$VSCodePath = if ($McpVSCodeConfigPath) { $McpVSCodeConfigPath } else { Join-Path $env:APPDATA "Code\User\mcp.json" }
$CopilotHome = if ($env:COPILOT_HOME) { $env:COPILOT_HOME } else { Join-Path $env:USERPROFILE ".copilot" }
$CopilotPath = Join-Path $CopilotHome "mcp-config.json"
$CodexHome = if ($env:CODEX_HOME) { $env:CODEX_HOME } else { Join-Path $env:USERPROFILE ".codex" }
$CodexPath = Join-Path $CodexHome "config.toml"

function Read-EnvFile([string]$Path) {
    if (-not (Test-Path -LiteralPath $Path)) {
        Write-Error "install-mcp-mem0: env file missing at $Path. Copy ~/.config/mcp/mcp-mem0.env.example and set MEM0_API_KEY."
    }
    foreach ($line in Get-Content -LiteralPath $Path) {
        $trimmed = $line.Trim()
        if ($trimmed -eq "" -or $trimmed.StartsWith("#")) { continue }
        $idx = $trimmed.IndexOf("=")
        if ($idx -lt 1) { continue }
        $key = $trimmed.Substring(0, $idx).Trim()
        $value = $trimmed.Substring($idx + 1).Trim().Trim('"').Trim("'")
        [Environment]::SetEnvironmentVariable($key, $value, "Process")
    }
}

function Read-JsonFile([string]$Path, [object]$Default) {
    if (-not (Test-Path -LiteralPath $Path)) { return $Default }
    $raw = Get-Content -LiteralPath $Path -Raw
    if ([string]::IsNullOrWhiteSpace($raw)) { return $Default }
    try {
        return $raw | ConvertFrom-Json -Depth 32
    } catch {
        Write-Error "install-mcp-mem0: invalid JSON in '$Path'. Fix the JSON or use a clean config path. $($_.Exception.Message)"
    }
}

function Write-JsonFileIfChanged([string]$Path, [object]$Data) {
    $new = ($Data | ConvertTo-Json -Depth 32)
    $old = $null
    if (Test-Path -LiteralPath $Path) {
        $old = Get-Content -LiteralPath $Path -Raw
    }
    if ($old -eq $new) { return $false }
    $dir = Split-Path -Parent $Path
    if ($dir) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
    if (Test-Path -LiteralPath $Path) {
        $stamp = Get-Date -Format "yyyyMMddHHmmss"
        Copy-Item -LiteralPath $Path -Destination "$Path.bak.$stamp" -Force
    }
    $new | Set-Content -LiteralPath $Path -Encoding UTF8
    return $true
}

function Ensure-ObjectProperty([object]$Object, [string]$Name, [object]$Value) {
    if ($Object.PSObject.Properties.Name -contains $Name) {
        $Object.$Name = $Value
    } else {
        $Object | Add-Member -NotePropertyName $Name -NotePropertyValue $Value
    }
}

function Patch-JsonMcpConfig([string]$Path, [string]$Top) {
    $config = Read-JsonFile $Path ([pscustomobject]@{})
    if (-not ($config.PSObject.Properties.Name -contains $Top) -or $null -eq $config.$Top) {
        Ensure-ObjectProperty $config $Top ([pscustomobject]@{})
    }
    Ensure-ObjectProperty $config.$Top "mem0" ([pscustomobject]@{
        type = "http"
        url = $Mem0Url
        headers = [pscustomobject]@{
            Authorization = 'Token ${MEM0_API_KEY}'
        }
    })
    Write-JsonFileIfChanged $Path $config | Out-Null
}

function Remove-TomlBlock([string]$Text, [string]$Header) {
    $lines = $Text -split "`r?`n"
    $out = New-Object System.Collections.Generic.List[string]
    $skipping = $false
    foreach ($line in $lines) {
        if ($line -match '^\s*\[.*\]\s*$') {
            $skipping = ($line.Trim() -eq $Header)
            if ($skipping) { continue }
        }
        if (-not $skipping) { $out.Add($line) }
    }
    return (($out -join "`n") -replace "`n{3,}", "`n`n").Trim()
}

function Patch-CodexConfig([string]$Path) {
    $old = $null
    $text = ""
    if (Test-Path -LiteralPath $Path) {
        $old = Get-Content -LiteralPath $Path -Raw
        $text = $old
    }
    $next = Remove-TomlBlock $text "[mcp_servers.mem0]"
    $next = Remove-TomlBlock $next "[mcp_servers.mem0.headers]"
    $block = @"
[mcp_servers.mem0]
url = "$Mem0Url"
enabled = true

[mcp_servers.mem0.headers]
Authorization = "Token `${MEM0_API_KEY}"
"@
    if ($next) { $next = "$next`n`n$block" } else { $next = $block }
    if ($old -eq $next) { return }
    $dir = Split-Path -Parent $Path
    if ($dir) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
    if (Test-Path -LiteralPath $Path) {
        $stamp = Get-Date -Format "yyyyMMddHHmmss"
        Copy-Item -LiteralPath $Path -Destination "$Path.bak.$stamp" -Force
    }
    $next | Set-Content -LiteralPath $Path -Encoding UTF8
}

Read-EnvFile $EnvPath
if ([string]::IsNullOrWhiteSpace([Environment]::GetEnvironmentVariable("MEM0_API_KEY", "Process"))) {
    Write-Error "install-mcp-mem0: MEM0_API_KEY is missing in $EnvPath."
}

Patch-JsonMcpConfig $VSCodePath "servers"
Patch-JsonMcpConfig $CopilotPath "mcpServers"
Patch-CodexConfig $CodexPath

Write-Host "mem0 MCP configured"
Write-Host "URL: $Mem0Url"
Write-Host "Env path: $EnvPath"
Write-Host "VS Code MCP config: $VSCodePath"
Write-Host "Copilot MCP config: $CopilotPath"
Write-Host "Codex config: $CodexPath"
