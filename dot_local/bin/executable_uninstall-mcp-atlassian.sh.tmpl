#!/usr/bin/env zsh
set -eu

REMOVE_LOGS=0
REMOVE_RUNTIME=0
VSCODE_MCP_CONFIG_PATH=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --remove-logs)
      REMOVE_LOGS=1
      shift
      ;;
    --remove-runtime)
      REMOVE_RUNTIME=1
      shift
      ;;
    --vscode-mcp-config-path)
      VSCODE_MCP_CONFIG_PATH="${2:-}"
      shift 2
      ;;
    *)
      echo "uninstall-mcp-atlassian: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

if [ "$(uname -s)" != "Darwin" ]; then
  echo "uninstall-mcp-atlassian: macOS uninstaller only. Windows uses uninstall-mcp-atlassian.ps1; Linux is intentionally out of scope." >&2
  exit 1
fi

BASE_DIR="$HOME/.local/share/mcp"
SERVER_DIR="$BASE_DIR/atlassian"
REGISTRY_PATH="$BASE_DIR/registry.json"
ENV_PATH="$SERVER_DIR/.env"
LOG_DIR="$SERVER_DIR/logs"
LABEL="dev.binarymisfit.mcp.atlassian"
PLIST_PATH="$HOME/Library/LaunchAgents/$LABEL.plist"
VSCODE_PATH="${VSCODE_MCP_CONFIG_PATH:-$HOME/Library/Application Support/Code/User/mcp.json}"
COPILOT_BASE="${COPILOT_HOME:-$HOME/.copilot}"
COPILOT_PATH="$COPILOT_BASE/mcp-config.json"
CODEX_PATH="${CODEX_HOME:-$HOME/.codex}/config.toml"

if ! launchctl bootout "gui/$(id -u)" "$PLIST_PATH" >/dev/null 2>&1; then
  echo "uninstall-mcp-atlassian: LaunchAgent was not loaded or could not be booted out; continuing." >&2
fi

rm -f "$PLIST_PATH"

remove_json_entry() {
  local path="$1"
  local top="$2"
  [ -f "$path" ] || return 0
  if ! TARGET_PATH="$path" TOP="$top" /usr/bin/osascript -l JavaScript <<'EOF'
ObjC.import('Foundation');
const env = $.NSProcessInfo.processInfo.environment;
const path = env.objectForKey('TARGET_PATH').js;
const top = env.objectForKey('TOP').js;
const fm = $.NSFileManager.defaultManager;
const data = $.NSData.dataWithContentsOfFile(path);
const text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
let obj = {};
try {
  obj = text.trim() ? JSON.parse(text) : {};
} catch (err) {
  throw new Error(`Invalid JSON in '${path}'. No changes were written. ${err.message}`);
}
let changed = false;
if (obj[top] && Object.prototype.hasOwnProperty.call(obj[top], 'mcp-atlassian')) {
  delete obj[top]['mcp-atlassian'];
  changed = true;
}
const out = JSON.stringify(obj, null, 2);
if (changed && out !== text) {
  const d = new Date();
  const pad = n => String(n).padStart(2, '0');
  const stamp = `${d.getFullYear()}${pad(d.getMonth()+1)}${pad(d.getDate())}${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;
  $(text).writeToFileAtomicallyEncodingError(`${path}.bak.${stamp}`, true, $.NSUTF8StringEncoding, null);
  $(out).writeToFileAtomicallyEncodingError(path, true, $.NSUTF8StringEncoding, null);
}
EOF
  then
    echo "uninstall-mcp-atlassian: invalid JSON or write failure in '$path'. Fix the JSON or pass a clean config path." >&2
    exit 1
  fi
}

backup_env() {
  [ -f "$ENV_PATH" ] || return 0
  local backup="$SERVER_DIR/.env.backup"
  if [ -e "$backup" ]; then
    backup="$SERVER_DIR/.env.backup.$(date +%Y%m%d%H%M%S)"
  fi
  mv "$ENV_PATH" "$backup"
}

remove_codex_config() {
  local path="$1"
  [ -f "$path" ] || return 0
  TARGET_PATH="$path" /usr/bin/osascript -l JavaScript <<'EOF'
ObjC.import('Foundation');
const path = $.NSProcessInfo.processInfo.environment.objectForKey('TARGET_PATH').js;
const data = $.NSData.dataWithContentsOfFile(path);
const text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
const lines = text.split(/\r?\n/);
const out = [];
let skipping = false;
for (const line of lines) {
  if (/^\s*\[.*\]\s*$/.test(line)) {
    skipping = line.trim() === '[mcp_servers.atlassian]';
    if (skipping) continue;
  }
  if (!skipping) out.push(line);
}
const next = out.join('\n').replace(/\n{3,}/g, '\n\n').trim();
if (next !== text) {
  const d = new Date();
  const pad = n => String(n).padStart(2, '0');
  const stamp = `${d.getFullYear()}${pad(d.getMonth()+1)}${pad(d.getDate())}${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;
  $(text).writeToFileAtomicallyEncodingError(`${path}.bak.${stamp}`, true, $.NSUTF8StringEncoding, null);
  $(next).writeToFileAtomicallyEncodingError(path, true, $.NSUTF8StringEncoding, null);
}
EOF
}

remove_json_entry "$VSCODE_PATH" "servers"
remove_json_entry "$COPILOT_PATH" "mcpServers"
remove_json_entry "$REGISTRY_PATH" "servers"
remove_codex_config "$CODEX_PATH"

backup_env

if [ "$REMOVE_LOGS" -eq 1 ]; then
  rm -rf "$LOG_DIR"
fi

if [ "$REMOVE_RUNTIME" -eq 1 ]; then
  rm -rf "$SERVER_DIR"
fi

echo "mcp-atlassian uninstalled. .env preserved as backup when present. Logs retained unless --remove-logs was passed."
