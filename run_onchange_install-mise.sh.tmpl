{{ if ne .chezmoi.os "windows" -}}
#!/usr/bin/env sh
set -eu

# mise config hash: {{ includeTemplate "private_dot_config/mise/config.toml.tmpl" . | sha256sum }}

export PATH="$HOME/.local/bin:$HOME/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/share/mise/shims:$PATH"

if ! command -v mise >/dev/null 2>&1; then
  echo "install-mise: mise not found; run bootstrap first"
  exit 1
fi

ARCH="$(uname -m)"
if [ "$ARCH" = "armv6l" ] || [ "$ARCH" = "armv7l" ]; then
  echo "install-mise: $ARCH detected, skipping mise install"
  exit 0
fi

mise install
mise reshim
{{ end -}}
