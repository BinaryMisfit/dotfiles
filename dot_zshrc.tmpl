# Enable Powerlevel10k instant prompt (if installed)
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Only proceed for interactive shells
[[ -o interactive ]] || return

# -----------------------------------------------------------------------------
# Host / OS context
# chezmoi renders this file per target machine. Keep OS-specific assumptions here,
# not scattered across the rest of the shell config like confetti from a bad deploy.
# -----------------------------------------------------------------------------
export DOTFILES_OS="{{ .chezmoi.os }}"
export DOTFILES_ARCH="{{ .chezmoi.arch }}"

if [[ -r /etc/os-release ]]; then
  . /etc/os-release
  export DOTFILES_DISTRO="${ID:-linux}"
  export DOTFILES_DISTRO_LIKE="${ID_LIKE:-}"
else
  export DOTFILES_DISTRO="$DOTFILES_OS"
  export DOTFILES_DISTRO_LIKE=""
fi

[[ -r "$HOME/.config/shell/helpers.zsh" ]] && source "$HOME/.config/shell/helpers.zsh"

# -----------------------------------------------------------------------------
# PATH
# Priority model:
#   1. mise shims after activation
#   2. user-local tools
#   3. OS package manager tools
#   4. system tools
# -----------------------------------------------------------------------------
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/bin"

{{- if eq .chezmoi.os "darwin" }}
# macOS Homebrew paths. Apple Silicon uses /opt/homebrew, Intel uses /usr/local.
# Keep this macOS-only; Linux gets apt + mise, not Homebrew cosplay.
if [[ -d /opt/homebrew/bin ]]; then
  path_prepend /opt/homebrew/sbin
  path_prepend /opt/homebrew/bin
elif [[ -d /usr/local/bin ]]; then
  path_prepend /usr/local/sbin
  path_prepend /usr/local/bin
fi
{{- end }}

{{- if eq .chezmoi.os "linux" }}
# Debian / Ubuntu / Raspbian stay intentionally boring here.
# System packages come from apt; developer tools come from mise.
# No Linuxbrew path unless you deliberately add it later. Future-you is welcome.
{{- end }}

# mise
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Terminal
export TERM=${TERM:-xterm-256color}
export COLORTERM=${COLORTERM:-truecolor}

# History config (must come before plugins that use history)
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
HISTORY_SUBSTRING_SEARCH_PREFIXED=true

# Zsh options
setopt AUTOCD EXTENDED_GLOB HIST_FIND_NO_DUPS HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS INC_APPEND_HISTORY NO_BEEP SHARE_HISTORY

# Fallback prompt only. Powerlevel10k owns the real prompt once loaded.
if [[ -z "${POWERLEVEL9K_LEFT_PROMPT_ELEMENTS:-}" ]]; then
  export PS1="%n@%m %1~ %# "
fi

# -----------------------------------------------------------------------------
# Znap Plugin Manager
# -----------------------------------------------------------------------------
if [[ ! -d "$HOME/.zsh/plugins/znap" ]]; then
  mkdir -p "$HOME/.zsh/plugins"
  ( git clone --depth=1 https://github.com/marlonrichert/zsh-snap.git "$HOME/.zsh/plugins/znap" >/dev/null 2>&1 & )
fi

if [[ -s "$HOME/.zsh/plugins/znap/znap.zsh" ]]; then
  source "$HOME/.zsh/plugins/znap/znap.zsh" 2>/dev/null || true

  znap source marlonrichert/zsh-autosuggestions 2>/dev/null || true
  znap source zdharma-continuum/fast-syntax-highlighting 2>/dev/null || true
  znap source zsh-users/zsh-completions 2>/dev/null || true
  znap source zsh-users/zsh-history-substring-search 2>/dev/null || true
  znap source romkatv/zsh-defer || true
  znap prompt romkatv/powerlevel10k 2>/dev/null || true
fi

# Completion
# Run outside the znap block so baseline completion still works while znap is
# cloning/updating/missing. zsh-completions is loaded above when available.
autoload -Uz compinit
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump" >/dev/null 2>&1 || true

# fzf-tab must load after compinit. Loading it before compinit causes platform-
# specific completion weirdness, because apparently Tab needs a throne order.
if (( $+commands[znap] )); then
  znap source Aloxaf/fzf-tab 2>/dev/null || true
fi

# Powerlevel10k user config
[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

[[ -r "$HOME/.config/shell/fzf.zsh" ]] && source "$HOME/.config/shell/fzf.zsh"

if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh --disable-up-arrow --disable-ai)"
  bindkey '^R' atuin-search
fi

# Neovim
export EDITOR=nvim
export VISUAL=nvim

# Aliases
[[ -r "$HOME/.config/shell/aliases.zsh" ]] && source "$HOME/.config/shell/aliases.zsh"

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# Final keybinding overrides
# Keep Tab deterministic after fzf and fzf-tab have both tried to claim the throne.
if (( $+functions[fzf-tab-complete] )); then
  bindkey '^I' fzf-tab-complete 2>/dev/null || true
  bindkey -M emacs '^I' fzf-tab-complete 2>/dev/null || true
  bindkey -M viins '^I' fzf-tab-complete 2>/dev/null || true
else
  bindkey '^I' complete-word 2>/dev/null || true
  bindkey -M emacs '^I' complete-word 2>/dev/null || true
  bindkey -M viins '^I' complete-word 2>/dev/null || true
fi

# Keep ↑/↓ as history-substring search, even if plugins get grabby.
if (( $+functions[history-substring-search-up] )); then
  # Normal cursor mode
  bindkey -M emacs '^[[A' history-substring-search-up
  bindkey -M emacs '^[[B' history-substring-search-down
  bindkey -M viins '^[[A' history-substring-search-up
  bindkey -M viins '^[[B' history-substring-search-down

  # Application cursor mode, common in some terminals
  bindkey -M emacs '^[OA' history-substring-search-up
  bindkey -M emacs '^[OB' history-substring-search-down
  bindkey -M viins '^[OA' history-substring-search-up
  bindkey -M viins '^[OB' history-substring-search-down

  # Ctrl-P / Ctrl-N fallback
  bindkey -M emacs '^P' history-substring-search-up
  bindkey -M emacs '^N' history-substring-search-down
  bindkey -M viins '^P' history-substring-search-up
  bindkey -M viins '^N' history-substring-search-down
fi


# -----------------------------------------------------------------------------
# iTerm2 shell integration
# -----------------------------------------------------------------------------
# Loaded late so prompt/plugins/keybindings have finished their little turf war.
# Do not require ITERM_SESSION_ID: it is not present on normal SSH sessions.
if [[ -o interactive && -r "$HOME/.iterm2_shell_integration.zsh" ]]; then
  source "$HOME/.iterm2_shell_integration.zsh"
fi
