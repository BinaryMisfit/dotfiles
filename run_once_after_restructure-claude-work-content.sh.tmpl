{{ if ne .chezmoi.os "windows" -}}
{{- $profile := get . "profile" | default "home" -}}
#!/usr/bin/env sh
set -u

# One-time cleanup for the Claude Code work/home restructure (ADR 0006/0007):
# rules/*.instructions.md moved to rules/work/*.instructions.md, and several
# skills + output-styles/k1ra.md became work-profile-only instead of
# deploying unconditionally. Removes stale content left at the old paths on
# any machine that had already applied the previous flat structure.

CLAUDE_DIR="$HOME/.claude"

echo "==> removing old flat-path Claude rule files"
rm -f \
  "$CLAUDE_DIR/rules/branches.instructions.md" \
  "$CLAUDE_DIR/rules/external-services.instructions.md" \
  "$CLAUDE_DIR/rules/jira.instructions.md" \
  "$CLAUDE_DIR/rules/pull-requests.instructions.md"

{{ if ne $profile "work" -}}
echo "==> non-work profile: removing work-only Claude skills and output styles"
rm -rf \
  "$CLAUDE_DIR/skills/branch-start-work" \
  "$CLAUDE_DIR/skills/commit-ready-check" \
  "$CLAUDE_DIR/skills/continuation-context-pack" \
  "$CLAUDE_DIR/skills/defect-workflow" \
  "$CLAUDE_DIR/skills/feature-workflow" \
  "$CLAUDE_DIR/skills/jira-post-fix-update-comment" \
  "$CLAUDE_DIR/skills/jira-post-qa-test-plan" \
  "$CLAUDE_DIR/skills/jira-transition-status" \
  "$CLAUDE_DIR/skills/jira-unassign-ticket" \
  "$CLAUDE_DIR/skills/post-pr-cleanup" \
  "$CLAUDE_DIR/skills/pr-prep-and-submit" \
  "$CLAUDE_DIR/skills/project-setup" \
  "$CLAUDE_DIR/output-styles/k1ra.md"
{{ end -}}
{{ end -}}
