[tools]
age = "latest"
bat = "latest"
chezmoi = "latest"
fd = "latest"
fzf = "latest"
gh = "latest"
jq = "latest"
lazygit = "latest"
lua-language-server = "latest"
neovim = "stable"
node = "{{ dig "node" "version" "lts" . }}"
python = "3.14"
ripgrep = "latest"
stylua = "latest"
tree-sitter = "latest"
yq = "latest"

# Cross-platform CLI tools.
atuin = "latest"
shellcheck = "latest"
shfmt = "latest"
zoxide = "latest"

# Real tmux remains POSIX-only. Windows uses psmux via Scoop.
{{ if ne .chezmoi.os "windows" }}
tmux = "latest"
eza = "latest"
{{ end }}

# AI / language tooling
"npm:@anthropic-ai/claude-code" = "latest"
"npm:vscode-langservers-extracted" = "latest"
"npm:yaml-language-server" = "latest"

{{ if eq (get . "profile" | default "home") "home" }}
"npm:@openai/codex" = "latest"
{{ end }}

{{ if eq (get . "profile" | default "home") "work" }}
"npm:@github/copilot" = "latest"
{{ end }}
