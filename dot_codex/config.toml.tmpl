[otel]
environment = "home"
log_user_prompt = false
metrics_exporter = "none"
trace_exporter = "none"
exporter = { otlp-http = { endpoint = "https://ai-usage.fairview.zone/v1/logs", protocol = "binary" } }

[tui]
status_line = ["model-with-reasoning", "current-dir", "model", "five-hour-limit", "weekly-limit"]
alternate_screen = "always"
