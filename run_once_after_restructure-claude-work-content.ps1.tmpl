{{ if eq .chezmoi.os "windows" -}}
{{- $profile := get . "profile" | default "home" -}}
#!powershell
$ErrorActionPreference = "Continue"

# One-time cleanup for the Claude Code work/home restructure (ADR 0006/0007):
# rules/*.instructions.md moved to rules/work/*.instructions.md, and several
# skills + output-styles/k1ra.md became work-profile-only instead of
# deploying unconditionally. Removes stale content left at the old paths on
# any machine that had already applied the previous flat structure.

$ClaudeDir = Join-Path $HOME ".claude"

Write-Host "==> removing old flat-path Claude rule files"

$OldRuleFiles = @(
    "rules\branches.instructions.md",
    "rules\external-services.instructions.md",
    "rules\jira.instructions.md",
    "rules\pull-requests.instructions.md"
)

foreach ($RelPath in $OldRuleFiles) {
    Remove-Item -Force -Path (Join-Path $ClaudeDir $RelPath) -ErrorAction SilentlyContinue
}

{{ if ne $profile "work" -}}
Write-Host "==> non-work profile: removing work-only Claude skills and output styles"

$WorkOnlySkills = @(
    "branch-start-work",
    "commit-ready-check",
    "continuation-context-pack",
    "defect-workflow",
    "feature-workflow",
    "jira-post-fix-update-comment",
    "jira-post-qa-test-plan",
    "jira-transition-status",
    "jira-unassign-ticket",
    "post-pr-cleanup",
    "pr-prep-and-submit",
    "project-setup"
)

foreach ($Skill in $WorkOnlySkills) {
    Remove-Item -Recurse -Force -Path (Join-Path $ClaudeDir "skills\$Skill") -ErrorAction SilentlyContinue
}

Remove-Item -Force -Path (Join-Path $ClaudeDir "output-styles\k1ra.md") -ErrorAction SilentlyContinue
{{ end -}}
{{ end -}}
