# Local overrides (NOT tracked)
Include ~/.ssh/config.local
Include ~/.ssh/conf.d/*

# Github
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_github
  IdentitiesOnly yes
  AddKeysToAgent yes

# GitGud
Host ssh.gitgud.io
  HostName ssh.gitgud.io
  User git
  IdentityFile ~/.ssh/id_ed25519_github
  IdentitiesOnly yes
  AddKeysToAgent yes

# Digital Misfit (formerly Fairview)
Host git.digitalmisfit.net
  HostName git.digitalmisfit.net
  Port 10022
  User git
  IdentityFile ~/.ssh/id_ed25519_github
  IdentitiesOnly yes
  AddKeysToAgent yes

# Global defaults
Host *
  AddKeysToAgent yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  SendEnv LANG LC_*

