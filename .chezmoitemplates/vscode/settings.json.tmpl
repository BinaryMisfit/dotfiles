{{- $layout := get (index . "vscode" | default dict) "layout" | default "large" -}}
{{- $small := eq $layout "small" -}}
{{- $vscode := get . "vscode" | default dict -}}
{{- $extra := get $vscode "extraSettings" | default dict -}}
{
  // --- Core ---
  {{- if eq .chezmoi.os "windows" }}
  "window.restoreFullscreen": false,
  "window.newWindowDimensions": "inherit",
  "window.restoreWindows": "none",
  {{- else if eq .chezmoi.os "darwin" }}
  "window.restoreFullscreen": true,
  "window.newWindowDimensions": "fullscreen",
  {{- end }}
  "security.workspace.trust.untrustedFiles": "prompt",
  "files.hotExit": "off",

  // --- Theme ---
  "workbench.colorTheme": "Atom One Dark",
  "workbench.iconTheme": "material-icon-theme",

  // --- Editor ---
  "editor.fontFamily": "FiraCode Nerd Font, Monaco, 'Courier New', monospace",
  {{- if eq .chezmoi.os "windows" }}
  "editor.fontSize": 16,
  {{- else if eq .chezmoi.os "darwin" }}
  "editor.fontSize": 14,
  {{- end }}
  "editor.fontLigatures": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.formatOnSave": true,
  "editor.stickyScroll.enabled": false,

  // --- Layout / Focus ---
  "workbench.editor.enablePreview": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.activityBar.location": {{ if $small }}"default"{{ else }}"top"{{ end }},
  "workbench.sideBar.location": "left",
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.startupEditor": "none",

  // --- Terminal ---
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.defaultLocation": {{ if $small }}"editor"{{ else }}"view"{{ end }},
  "terminal.integrated.tabs.hideCondition": "singleTerminal",
  "terminal.integrated.fontFamily": "MesloLGS Nerd Font",
  {{- if eq .chezmoi.os "windows" }}
  "terminal.integrated.fontSize": 16,
  {{- else if eq .chezmoi.os "darwin" }}
  "terminal.integrated.fontSize": 14,
  {{- end }}

  // --- AI / Chat ---
  {{- if eq .chezmoi.os "windows" }}
  "chat.editor.fontSize": 16,
  {{- else if eq .chezmoi.os "darwin" }}
  "chat.editor.fontSize": 14,
  {{- end }}
  "chat.agent.thinkingStyle": "collapsed",
  "chat.progressBorder.enabled": true,
  "chat.persistentProgress.enabled": true,
  "chat.unifiedAgentsBar.enabled": true,
  "chat.viewProgressBadge.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "chat.mcp.gallery.enabled": true,
  "chat.tools.terminal.autoApprove": {
    "/^(Get-ChildItem|Get-Content|Select-String|Where-Object|ForEach-Object|ConvertFrom-Json|Write-Output|echo)(\\s|$)/i": true,
    "/^(if|foreach|where|select)(\\s|$)/i": true,

    "/^rg(\\s|$)/i": true,

    "/^git\\s+(-C\\s+\\S+\\s+)?(status|diff|log|show|branch|remote|rev-parse|ls-files)(\\s|$)/i": true,

    "/^ansible-inventory(\\s|$)/i": true,
    "/^ansible(-playbook)?\\s+.*(--check|--syntax-check|--list-hosts|--list-tasks|--list-tags|--diff)(\\s|$)/i": true,

    "/^adb(\\.exe)?\\s+(version|devices(\\s+-l)?|start-server)(\\s|$)/i": true,
    "/^adb(\\.exe)?\\s+logcat(\\s+[^;&|]+)*(\\s*\\|\\s*(findstr|grep)\\s+[^;&|]+)*(\\s*;\\s*adb(\\.exe)?\\s+logcat(\\s+[^;&|]+)*(\\s*\\|\\s*(findstr|grep)\\s+[^;&|]+)*)?$/i": true,
    "/^adb(\\.exe)?\\s+shell\\s+pm\\s+list\\s+packages(\\s*\\|\\s*(findstr|grep)\\s+[^;&|]+)?$/i": true,

    "/^\\.\\\\gradlew\\.bat\\s+(?::[\\w-]+:)*(test|build|check|assemble|lint|test(Debug|Release)UnitTest|install(Debug|Release)|tasks|help|properties|dependencies)(\\s+--tests\\s+\"[^\"]+\")?(\\s+--[\\w.-]+(=[\\w.-]+)?)*\\s*$/i": true,

    "/^pwsh\\s+-c\\s+\"(adb(\\.exe)?\\s+(version|devices(\\s+-l)?|start-server|logcat.*|shell\\s+pm\\s+list\\s+packages.*)|\\.\\\\gradlew\\.bat\\s+(?::[\\w-]+:)*(test|build|check|assemble|lint|test(Debug|Release)UnitTest|install(Debug|Release)|tasks|help|properties|dependencies)(\\s+--tests\\s+['\\\"]?[^'\\\"]+['\\\"]?)?(\\s+--[\\w.-]+(=[\\w.-]+)?)*\\s*)\"$/i": true,

    "/^pwsh(\\s|$)/i": false,

    "/^git\\s+(-C\\s+\\S+\\s+)?(checkout|switch|reset|clean|restore|merge|rebase|pull|push|commit|add|rm|mv)(\\s|$)/i": false,
    "/^ansible-playbook(?!.*(--check|--syntax-check|--list-hosts|--list-tasks|--list-tags))(\\s|$)/i": false,
    "/^adb(\\.exe)?\\s+(install|uninstall|push|pull|shell\\s+(?!pm\\s+list\\s+packages).*)/i": false,

    "/\\b(rm|del|Remove-Item|rmdir|Remove-Variable|Set-Content|Add-Content|Out-File|New-Item|Move-Item|Copy-Item|Rename-Item)\\b/i": false,
    "/\\b(curl|Invoke-WebRequest|iwr|wget)\\b.*\\|\\s*(sh|bash|pwsh|powershell)/i": false,
    "/\\b(chmod|chown|sudo|su|scp|rsync|ssh)\\b/i": false,
    "/\\b(docker|docker-compose|podman)\\s+(run|exec|compose|up|down|rm|rmi|volume|network|system|restart|stop|kill|pull|push|build)\\b/i": false
  }

  // --- Vim ---
  "vim.useSystemClipboard": true,
  "vim.hlsearch": true,
  "vim.smartRelativeLine": true,
  "vim.incsearch": true,
  "vim.ignorecase": true,
  "vim.smartcase": true,

  // --- Remote ---
  "remote.SSH.remotePlatform": {
    "netctrl": "linux"
  }

  {{- range $key, $value := $extra }},
  {{ $key | quote }}: {{ $value | toJson }}
  {{- end }}
}
