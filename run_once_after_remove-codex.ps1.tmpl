{{ if eq .chezmoi.os "windows" -}}
#!powershell
$ErrorActionPreference = "Stop"

# One-time cleanup: Codex config (dot_codex/) has been excluded from
# deployment via .chezmoiignore/.chezmoiremove for a while, but the
# @openai/codex npm package kept getting installed on home profile until
# this change removed that line too - see ADR 0008. Uninstalls it from any
# machine that already has it, so the removal is actually complete per
# ADR 0004's scripted-cleanup requirement.

if (Get-Command npm -ErrorAction SilentlyContinue) {
    $installed = npm list -g @openai/codex 2>$null
    if ($LASTEXITCODE -eq 0) {
        Write-Host "==> removing globally-installed @openai/codex"
        npm uninstall -g @openai/codex
    }
}
{{ end -}}
